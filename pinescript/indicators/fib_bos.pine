//@version=5
indicator("BOS + Fibonacci [FibBOS]", overlay=true, max_lines_count=50, max_labels_count=50)

// === INPUTS ===
// --- Structure ---
inp_swing_left    = input.int(5,    "Swing Left Bars",    minval=2, maxval=20, group="Structure")
inp_swing_right   = input.int(3,    "Swing Right Bars",   minval=1, maxval=10, group="Structure")
inp_atr_period    = input.int(14,   "ATR Period",         group="Structure")
inp_max_impulse   = input.float(3.0,"Max Impulse (ATR x)",group="Structure", tooltip="Skip if impulse too large (spread)")
inp_min_impulse   = input.float(0.5,"Min Impulse (ATR x)",group="Structure")

// --- Fibonacci ---
inp_fib_gp_lo  = input.float(0.500, "Golden Pocket Low",  group="Fibonacci", step=0.001)
inp_fib_gp_hi  = input.float(0.618, "Golden Pocket High", group="Fibonacci", step=0.001)
inp_fib_inv    = input.float(0.786, "Invalidation Level", group="Fibonacci", step=0.001)
inp_fib_tp1    = input.float(0.272, "TP1 Extension",      group="Fibonacci", step=0.001, tooltip="1.272 = 0.272 beyond top")
inp_fib_tp2    = input.float(0.618, "TP2 Extension",      group="Fibonacci", step=0.001, tooltip="1.618")
inp_fib_tp3    = input.float(1.000, "TP3 Extension",      group="Fibonacci", step=0.001, tooltip="2.000")

// --- Filters ---
inp_ema_filter    = input.bool(true,  "EMA Trend Filter",   group="Filters")
inp_ema_period    = input.int(200,    "EMA Period",         group="Filters")
inp_vol_filter    = input.bool(true,  "Volume Filter",      group="Filters")
inp_vol_mult      = input.float(1.2,  "Volume Spike Mult",  group="Filters")
inp_vol_window    = input.int(10,     "Volume Avg Window",  group="Filters")
inp_atr_regime    = input.bool(true,  "ATR Regime Filter",  group="Filters")
inp_regime_lo     = input.float(0.8,  "Regime ATR Ratio Lo",group="Filters")
inp_regime_hi     = input.float(2.0,  "Regime ATR Ratio Hi",group="Filters")
inp_atr_long      = input.int(96,     "ATR Long Period",    group="Filters")

// --- Entry Mode ---
inp_entry_mode    = input.string("Conservative", "Entry Mode", options=["Aggressive","Conservative","Zone"], group="Entry",
                      tooltip="Aggressive: limit at 0.618 on BOS\nConservative: wait for bullish close in pocket\nZone: enter at touch of 0.5")

// --- Session ---
inp_use_session   = input.bool(false, "Session Filter",     group="Session")
inp_sess_start    = input.int(7,      "Session Start (UTC)",group="Session")
inp_sess_end      = input.int(20,     "Session End (UTC)",  group="Session")

// --- Display ---
inp_show_fibs     = input.bool(true,  "Show Fib Levels",    group="Display")
inp_show_bos      = input.bool(true,  "Show BOS Labels",    group="Display")
inp_show_table    = input.bool(true,  "Show Info Table",    group="Display")
inp_show_tp_lines = input.bool(true,  "Show TP Lines",      group="Display")

// === CALCULATIONS ===
ema200    = ta.ema(close, inp_ema_period)
atr_short = ta.atr(inp_atr_period)
atr_long  = ta.atr(inp_atr_long)
vol_avg   = ta.sma(volume, inp_vol_window)

trend_bull = close > ema200
trend_bear = close < ema200

vol_spike = volume > vol_avg * inp_vol_mult
vol_ratio = atr_short / atr_long
regime_ok = vol_ratio > inp_regime_lo and vol_ratio < inp_regime_hi

session_ok = inp_use_session == false or (hour >= inp_sess_start and hour < inp_sess_end)

swingH = ta.pivothigh(high, inp_swing_left, inp_swing_right)
swingL = ta.pivotlow(low,  inp_swing_left, inp_swing_right)

// === STATE VARIABLES ===
var float prevSwingHigh    = na
var float prevSwingLow     = na
var float impulse_lo_bull  = na   // Low of bull impulse (origin)
var float impulse_hi_bull  = na   // High of bull impulse (BOS bar)
var float impulse_hi_bear  = na   // High of bear impulse (origin)
var float impulse_lo_bear  = na   // Low of bear impulse (BOS bar)
var bool  bos_bull         = false
var bool  bos_bear         = false
var bool  bull_invald      = false
var bool  bear_invald      = false
var int   bos_bull_bar     = na
var int   bos_bear_bar     = na
var float bos_bull_level   = na   // The swing level that was broken (bull)
var float bos_bear_level   = na   // The swing level that was broken (bear)

// Update swing tracking
if not na(swingL)
    prevSwingLow      := swingL
    impulse_lo_bull   := swingL   // This LL is potential bull impulse origin

if not na(swingH)
    prevSwingHigh     := swingH
    impulse_hi_bear   := swingH   // This HH is potential bear impulse origin

// === BOS DETECTION ===
bosLong  = not na(prevSwingHigh) and close > prevSwingHigh and not bos_bull and session_ok
bosShort = not na(prevSwingLow)  and close < prevSwingLow  and not bos_bear and session_ok

if bosLong
    imp_r = high - impulse_lo_bull
    // Validate impulse size
    if not na(impulse_lo_bull) and imp_r >= atr_short * inp_min_impulse and imp_r <= atr_short * inp_max_impulse
        if inp_ema_filter == false or trend_bull
            if inp_vol_filter == false or vol_spike
                if inp_atr_regime == false or regime_ok
                    impulse_hi_bull := high
                    bos_bull_level  := prevSwingHigh
                    bos_bull        := true
                    bos_bear        := false
                    bull_invald     := false
                    bos_bull_bar    := bar_index
                    prevSwingHigh   := na
                    if inp_show_bos
                        label.new(bar_index, high, "BOS ▲", color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)

if bosShort
    imp_r = impulse_hi_bear - low
    if not na(impulse_hi_bear) and imp_r >= atr_short * inp_min_impulse and imp_r <= atr_short * inp_max_impulse
        if inp_ema_filter == false or trend_bear
            if inp_vol_filter == false or vol_spike
                if inp_atr_regime == false or regime_ok
                    impulse_lo_bear := low
                    bos_bear_level  := prevSwingLow
                    bos_bear        := true
                    bos_bull        := false
                    bear_invald     := false
                    bos_bear_bar    := bar_index
                    prevSwingLow    := na
                    if inp_show_bos
                        label.new(bar_index, low, "BOS ▼", color=color.red, textcolor=color.white, style=label.style_label_up, size=size.small)

// === FIB LEVELS ===
imp_r_bull = (not na(impulse_hi_bull) and not na(impulse_lo_bull)) ? impulse_hi_bull - impulse_lo_bull : na
f0_bull    = impulse_lo_bull
f500_bull  = not na(imp_r_bull) ? impulse_hi_bull - 0.500 * imp_r_bull : na
f618_bull  = not na(imp_r_bull) ? impulse_hi_bull - 0.618 * imp_r_bull : na
f786_bull  = not na(imp_r_bull) ? impulse_hi_bull - 0.786 * imp_r_bull : na
f1272_bull = not na(imp_r_bull) ? impulse_hi_bull + inp_fib_tp1 * imp_r_bull : na
f1618_bull = not na(imp_r_bull) ? impulse_hi_bull + inp_fib_tp2 * imp_r_bull : na
f2000_bull = not na(imp_r_bull) ? impulse_hi_bull + inp_fib_tp3 * imp_r_bull : na

imp_r_bear = (not na(impulse_hi_bear) and not na(impulse_lo_bear)) ? impulse_hi_bear - impulse_lo_bear : na
f0_bear    = impulse_hi_bear
f500_bear  = not na(imp_r_bear) ? impulse_lo_bear + 0.500 * imp_r_bear : na
f618_bear  = not na(imp_r_bear) ? impulse_lo_bear + 0.618 * imp_r_bear : na
f786_bear  = not na(imp_r_bear) ? impulse_lo_bear + 0.786 * imp_r_bear : na
f1272_bear = not na(imp_r_bear) ? impulse_lo_bear - inp_fib_tp1 * imp_r_bear : na
f1618_bear = not na(imp_r_bear) ? impulse_lo_bear - inp_fib_tp2 * imp_r_bear : na
f2000_bear = not na(imp_r_bear) ? impulse_lo_bear - inp_fib_tp3 * imp_r_bear : na

// === INVALIDATION ===
if bos_bull and not na(f786_bull) and low < f786_bull
    bull_invald := true
    bos_bull    := false

if bos_bear and not na(f786_bear) and high > f786_bear
    bear_invald := true
    bos_bear    := false

// === GOLDEN POCKET DETECTION ===
inPocketBull = bos_bull and not bull_invald and not na(f618_bull) and low <= f500_bull and close >= f618_bull
inPocketBear = bos_bear and not bear_invald and not na(f618_bear) and high >= f500_bear and close <= f618_bear

// === ENTRY CONDITIONS BY MODE ===
longSignal  = false
shortSignal = false

if inp_entry_mode == "Conservative"
    longSignal  := inPocketBull and close > open   // Bullish close in pocket
    shortSignal := inPocketBear and close < open   // Bearish close in pocket
else if inp_entry_mode == "Aggressive"
    longSignal  := bos_bull and not bull_invald and low <= f618_bull  // Touch of 0.618
    shortSignal := bos_bear and not bear_invald and high >= f618_bear
else  // Zone
    longSignal  := inPocketBull  // Any bar touching pocket
    shortSignal := inPocketBear

// Reset after signal
if longSignal
    bos_bull := false
if shortSignal
    bos_bear := false

// === SL / TP ===
long_sl  = not na(f786_bull) ? f786_bull - syminfo.mintick * 10 : na
long_tp1 = f1272_bull
long_tp2 = f1618_bull
long_tp3 = f2000_bull

short_sl  = not na(f786_bear) ? f786_bear + syminfo.mintick * 10 : na
short_tp1 = f1272_bear
short_tp2 = f1618_bear
short_tp3 = f2000_bear

// === PLOTS ===
plot(ema200, "EMA 200", color=color.new(color.orange, 50), linewidth=1)

// Fib levels when BOS active
plot(inp_show_fibs and bos_bull ? impulse_hi_bull : na, "Impulse Top (Bull)", color.new(color.gray, 60), 1, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f500_bull : na,       "0.500 Bull",         color.new(color.gold, 30),  1, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f618_bull : na,       "0.618 Bull",         color.new(color.green, 20), 2, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f786_bull : na,       "0.786 Bull (Inv)",   color.new(color.red, 30),   1, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f1272_bull : na,      "1.272 TP1 Bull",     color.new(color.blue, 40),  1, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f1618_bull : na,      "1.618 TP2 Bull",     color.new(color.blue, 20),  2, plot.style_linebr)
plot(inp_show_fibs and bos_bull ? f2000_bull : na,      "2.000 TP3 Bull",     color.new(color.blue, 10),  1, plot.style_linebr)

plot(inp_show_fibs and bos_bear ? impulse_lo_bear : na, "Impulse Bot (Bear)", color.new(color.gray, 60),  1, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f500_bear : na,       "0.500 Bear",         color.new(color.gold, 30),  1, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f618_bear : na,       "0.618 Bear",         color.new(color.red, 20),   2, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f786_bear : na,       "0.786 Bear (Inv)",   color.new(color.orange, 30),1, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f1272_bear : na,      "1.272 TP1 Bear",     color.new(color.purple, 40),1, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f1618_bear : na,      "1.618 TP2 Bear",     color.new(color.purple, 20),2, plot.style_linebr)
plot(inp_show_fibs and bos_bear ? f2000_bear : na,      "2.000 TP3 Bear",     color.new(color.purple, 10),1, plot.style_linebr)

// Signals
plotshape(longSignal,  "Long Signal",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(shortSignal, "Short Signal", shape.triangledown, location.abovebar, color.red,   size=size.normal)

// Golden Pocket highlight
bgcolor(inPocketBull ? color.new(color.green, 90) : inPocketBear ? color.new(color.red, 90) : na)

// Swing pivots
plotchar(not na(swingH), "Swing High", "●", location.abovebar, color.new(color.red, 50),   size=size.tiny)
plotchar(not na(swingL), "Swing Low",  "●", location.belowbar, color.new(color.green, 50), size=size.tiny)

// Info table
if inp_show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
    table.cell(t, 0, 0, "FibBOS",   text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(t, 0, 1, "EMA Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, trend_bull ? "BULL" : "BEAR", text_color=trend_bull ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "BOS State", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, bos_bull ? "BULL ACTIVE" : bos_bear ? "BEAR ACTIVE" : "IDLE", text_color=bos_bull ? color.green : bos_bear ? color.red : color.gray, text_size=size.tiny)
    table.cell(t, 0, 3, "In Pocket", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, inPocketBull ? "BULL GP ✓" : inPocketBear ? "BEAR GP ✓" : "—", text_color=inPocketBull ? color.green : inPocketBear ? color.red : color.gray, text_size=size.tiny)
    table.cell(t, 0, 4, "Vol Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, regime_ok ? "ACTIVE" : "LOW/HIGH", text_color=regime_ok ? color.green : color.orange, text_size=size.tiny)
    table.cell(t, 0, 5, "Vol Spike",  text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, vol_spike ? "YES" : "NO", text_color=vol_spike ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 6, "ATR",        text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(atr_short, "#.#####"), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 7, "Entry Mode", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7, inp_entry_mode, text_color=color.white, text_size=size.tiny)
