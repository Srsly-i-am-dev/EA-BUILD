//@version=5
indicator("FB-Razor BOS [Indicator]", shorttitle="FBRazor_BOS", overlay=true, max_labels_count=500, max_lines_count=500)

// ── INPUTS ───────────────────────────────────────────────────
// EMA Trend
inp_ema_fast     = input.int(21,      "EMA Fast",                group="Trend", minval=1)
inp_ema_slow     = input.int(55,      "EMA Slow",                group="Trend", minval=2)

// Swing/Pivot
inp_swing_left   = input.int(10,      "Pivot Left Bars",         group="Pivot", minval=1)
inp_swing_right  = input.int(5,       "Pivot Right Bars",        group="Pivot", minval=1)

// ATR / Impulse
inp_atr_period   = input.int(14,      "ATR Period",              group="Impulse", minval=2)
inp_atr_mult_min = input.float(0.8,   "Min Impulse ATR Multiple",group="Impulse", step=0.1)
inp_atr_mult_max = input.float(3.0,   "Max Impulse ATR Multiple",group="Impulse", step=0.1)

// Fibonacci
inp_fib_entry_hi = input.float(0.618, "Golden Pocket Top",       group="Fibonacci", step=0.01)
inp_fib_entry_lo = input.float(0.500, "Golden Pocket Bottom",    group="Fibonacci", step=0.01)
inp_fib_invalid  = input.float(0.786, "Invalidation Level",      group="Fibonacci", step=0.01)

// Filters & Display
inp_require_ema  = input.bool(true,   "Require EMA Trend Filter",group="Filters")
inp_show_fibs    = input.bool(true,   "Show Fib Levels",         group="Display")
inp_show_state   = input.bool(true,   "Show State Table",        group="Display")

// ── STATE MACHINE ────────────────────────────────────────────
// States: 0=Idle, 1=BOS Detected (waiting for retracement), 2=In Golden Pocket (Armed)
var int   state              = 0
var int   direction          = 0    // 1=bull, -1=bear
var float swing_level        = na   // The swing that was broken
var float impulse_lo         = na   // Origin of bull impulse (swing low before BOS)
var float impulse_hi         = na   // Top of bull impulse (BOS bar high)
var float impulse_orig_bear  = na   // Origin of bear impulse (swing high before BOS)
var float impulse_bot_bear   = na   // Bottom of bear impulse (BOS bar low)
var float prevSwingHigh      = na
var float prevSwingLow       = na

// Tracking for pivot origins
var float last_swing_low_val  = na
var float last_swing_high_val = na

// ── CALCULATIONS ─────────────────────────────────────────────
ema_fast = ta.ema(close, inp_ema_fast)
ema_slow = ta.ema(close, inp_ema_slow)
atr      = ta.atr(inp_atr_period)

trend_bull = ema_fast > ema_slow
trend_bear = ema_fast < ema_slow

swingH = ta.pivothigh(high, inp_swing_left, inp_swing_right)
swingL = ta.pivotlow(low,  inp_swing_left, inp_swing_right)

// Update swing tracking
if not na(swingL)
    prevSwingLow       := swingL
    last_swing_low_val := swingL

if not na(swingH)
    prevSwingHigh       := swingH
    last_swing_high_val := swingH

// ── STATE TRANSITIONS ────────────────────────────────────────

// Idle -> BOS Detected
if state == 0
    // Bullish BOS: close breaks above previous swing high
    if not na(prevSwingHigh) and close > prevSwingHigh
        imp_range = high - last_swing_low_val
        if not na(last_swing_low_val) and imp_range >= atr * inp_atr_mult_min and imp_range <= atr * inp_atr_mult_max
            if inp_require_ema == false or trend_bull
                state        := 1
                direction    := 1
                impulse_lo   := last_swing_low_val
                impulse_hi   := high
                swing_level  := prevSwingHigh
                prevSwingHigh := na

    // Bearish BOS: close breaks below previous swing low
    if state == 0 and not na(prevSwingLow) and close < prevSwingLow
        imp_range = last_swing_high_val - low
        if not na(last_swing_high_val) and imp_range >= atr * inp_atr_mult_min and imp_range <= atr * inp_atr_mult_max
            if inp_require_ema == false or trend_bear
                state            := 1
                direction        := -1
                impulse_orig_bear := last_swing_high_val
                impulse_bot_bear  := low
                swing_level       := prevSwingLow
                prevSwingLow      := na

// ── FIB LEVELS (computed from impulse leg) ───────────────────
imp_r_bull = (not na(impulse_hi) and not na(impulse_lo)) ? impulse_hi - impulse_lo : na
f05_bull   = not na(imp_r_bull) ? impulse_hi - 0.500 * imp_r_bull : na
f618_bull  = not na(imp_r_bull) ? impulse_hi - 0.618 * imp_r_bull : na
f786_bull  = not na(imp_r_bull) ? impulse_hi - 0.786 * imp_r_bull : na
f1272_bull = not na(imp_r_bull) ? impulse_hi + 0.272 * imp_r_bull : na
f1618_bull = not na(imp_r_bull) ? impulse_hi + 0.618 * imp_r_bull : na
f2000_bull = not na(imp_r_bull) ? impulse_hi + 1.000 * imp_r_bull : na

imp_r_bear = (not na(impulse_orig_bear) and not na(impulse_bot_bear)) ? impulse_orig_bear - impulse_bot_bear : na
f05_bear   = not na(imp_r_bear) ? impulse_bot_bear + 0.500 * imp_r_bear : na
f618_bear  = not na(imp_r_bear) ? impulse_bot_bear + 0.618 * imp_r_bear : na
f786_bear  = not na(imp_r_bear) ? impulse_bot_bear + 0.786 * imp_r_bear : na
f1272_bear = not na(imp_r_bear) ? impulse_bot_bear - 0.272 * imp_r_bear : na
f1618_bear = not na(imp_r_bear) ? impulse_bot_bear - 0.618 * imp_r_bear : na
f2000_bear = not na(imp_r_bear) ? impulse_bot_bear - 1.000 * imp_r_bear : na

// Invalidation: price through 0.786
if state == 1 or state == 2
    if direction == 1 and not na(f786_bull) and low < f786_bull
        state := 0
    if direction == -1 and not na(f786_bear) and high > f786_bear
        state := 0

// BOS Detected -> In Golden Pocket (Armed)
if state == 1
    if direction == 1 and not na(f618_bull) and not na(f05_bull) and low <= f05_bull and close >= f618_bull
        state := 2
    if direction == -1 and not na(f618_bear) and not na(f05_bear) and high >= f05_bear and close <= f618_bear
        state := 2

// ── SIGNALS ──────────────────────────────────────────────────
longSignal  = state == 2 and direction == 1  and close > open
shortSignal = state == 2 and direction == -1 and close < open

// After signal, reset state
if longSignal or shortSignal
    state := 0

// ── SL / TP ─────────────────────────────────────────────────
long_sl   = direction == 1  ? (not na(f786_bull) ? f786_bull - syminfo.mintick * 10 : na) : na
long_tp1  = f1272_bull
long_tp2  = f1618_bull
long_tp3  = f2000_bull
short_sl  = direction == -1 ? (not na(f786_bear) ? f786_bear + syminfo.mintick * 10 : na) : na
short_tp1 = f1272_bear
short_tp2 = f1618_bear
short_tp3 = f2000_bear

// ── VISUALS ──────────────────────────────────────────────────
// EMA lines
plot(ema_fast, "EMA Fast", color.blue, 1)
plot(ema_slow, "EMA Slow", color.orange, 1)

// Entry signals
plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(shortSignal, "Short", shape.triangledown,  location.abovebar, color.red,   size=size.normal)

// Fib level plots (only when active setup exists)
show_bull_fibs = inp_show_fibs and state >= 1 and direction == 1
show_bear_fibs = inp_show_fibs and state >= 1 and direction == -1

// Bull fib levels
plot(show_bull_fibs ? f05_bull   : na, "Bull 0.500",  color.new(color.yellow, 30), 1, plot.style_circles)
plot(show_bull_fibs ? f618_bull  : na, "Bull 0.618",  color.new(color.orange, 30), 1, plot.style_circles)
plot(show_bull_fibs ? f786_bull  : na, "Bull 0.786",  color.new(color.red, 30),    1, plot.style_circles)
plot(show_bull_fibs ? f1272_bull : na, "Bull 1.272",  color.new(color.lime, 30),   1, plot.style_cross)
plot(show_bull_fibs ? f1618_bull : na, "Bull 1.618",  color.new(color.green, 30),  1, plot.style_cross)
plot(show_bull_fibs ? f2000_bull : na, "Bull 2.000",  color.new(color.teal, 30),   1, plot.style_cross)

// Bear fib levels
plot(show_bear_fibs ? f05_bear   : na, "Bear 0.500",  color.new(color.yellow, 30), 1, plot.style_circles)
plot(show_bear_fibs ? f618_bear  : na, "Bear 0.618",  color.new(color.orange, 30), 1, plot.style_circles)
plot(show_bear_fibs ? f786_bear  : na, "Bear 0.786",  color.new(color.red, 30),    1, plot.style_circles)
plot(show_bear_fibs ? f1272_bear : na, "Bear 1.272",  color.new(color.lime, 30),   1, plot.style_cross)
plot(show_bear_fibs ? f1618_bear : na, "Bear 1.618",  color.new(color.green, 30),  1, plot.style_cross)
plot(show_bear_fibs ? f2000_bear : na, "Bear 2.000",  color.new(color.teal, 30),   1, plot.style_cross)

// Golden pocket fill
gp_top = show_bull_fibs ? f05_bull : show_bear_fibs ? f05_bear : na
gp_bot = show_bull_fibs ? f618_bull : show_bear_fibs ? f618_bear : na
p_gp1 = plot(gp_top, "GP Top", color.new(color.purple, 80), display=display.none)
p_gp2 = plot(gp_bot, "GP Bot", color.new(color.purple, 80), display=display.none)
fill(p_gp1, p_gp2, color.new(color.purple, 85), title="Golden Pocket Zone")

// Background color when in golden pocket
bgcolor(state == 2 and direction == 1  ? color.new(color.green, 92) : na, title="Bull GP Active")
bgcolor(state == 2 and direction == -1 ? color.new(color.red, 92)   : na, title="Bear GP Active")

// TP/SL lines on signal
if longSignal
    line.new(bar_index, long_sl,  bar_index + 20, long_sl,  color=color.new(color.red, 30),  width=2, style=line.style_dashed)
    line.new(bar_index, long_tp1, bar_index + 20, long_tp1, color=color.new(color.lime, 30), width=1, style=line.style_dashed)
    line.new(bar_index, long_tp2, bar_index + 20, long_tp2, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    line.new(bar_index, long_tp3, bar_index + 20, long_tp3, color=color.new(color.lime, 30), width=1, style=line.style_dotted)
    label.new(bar_index, long_sl,  "SL",  color=color.new(color.red, 30),  textcolor=color.white, size=size.tiny)
    label.new(bar_index, long_tp1, "TP1", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, long_tp2, "TP2", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, long_tp3, "TP3", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)

if shortSignal
    line.new(bar_index, short_sl,  bar_index + 20, short_sl,  color=color.new(color.red, 30),  width=2, style=line.style_dashed)
    line.new(bar_index, short_tp1, bar_index + 20, short_tp1, color=color.new(color.lime, 30), width=1, style=line.style_dashed)
    line.new(bar_index, short_tp2, bar_index + 20, short_tp2, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    line.new(bar_index, short_tp3, bar_index + 20, short_tp3, color=color.new(color.lime, 30), width=1, style=line.style_dotted)
    label.new(bar_index, short_sl,  "SL",  color=color.new(color.red, 30),  textcolor=color.white, size=size.tiny)
    label.new(bar_index, short_tp1, "TP1", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, short_tp2, "TP2", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, short_tp3, "TP3", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)

// State diamond indicator
stateColor = state == 0 ? color.gray : state == 1 ? color.yellow : color.lime
plotshape(state > 0, "State Active", shape.diamond, location.bottom, stateColor, size=size.tiny)

// ── STATE TABLE ──────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast and inp_show_state
    table.cell(tbl, 0, 0, "FB-Razor BOS", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "v2.0",         text_color=color.yellow, text_size=size.small)

    table.cell(tbl, 0, 1, "State", text_color=color.gray, text_size=size.tiny)
    stateStr = state == 0 ? "Idle" : state == 1 ? "BOS Detected" : "Armed (GP)"
    table.cell(tbl, 1, 1, stateStr, text_color=stateColor, text_size=size.tiny)

    table.cell(tbl, 0, 2, "Direction", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, direction == 1 ? "BULL" : direction == -1 ? "BEAR" : "NONE", text_color=direction == 1 ? color.lime : direction == -1 ? color.red : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 3, "Impulse Range", text_color=color.gray, text_size=size.tiny)
    imp_disp = direction == 1 ? imp_r_bull : direction == -1 ? imp_r_bear : na
    table.cell(tbl, 1, 3, not na(imp_disp) ? str.tostring(imp_disp, "#.#####") : "N/A", text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 4, "ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(atr, "#.#####"), text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 5, "Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 5, trend_bull ? "BULL" : trend_bear ? "BEAR" : "FLAT", text_color=trend_bull ? color.lime : trend_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 6, "EMA Filter", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, inp_require_ema ? "ON" : "OFF", text_color=inp_require_ema ? color.lime : color.gray, text_size=size.tiny)
