//@version=5
indicator("Zigzag Sniper [BOS+Fib]", shorttitle="ZZSniper", overlay=true, max_labels_count=500, max_lines_count=500)

// ── INPUTS ───────────────────────────────────────────────────
i_zzLen        = input.int(5,     "Zigzag Length",        group="Zigzag", minval=2)
i_maxPivots    = input.int(20,    "Max Pivots",           group="Zigzag", minval=5)
i_showZZ       = input.bool(true, "Show Zigzag Lines",    group="Zigzag")
i_showLabels   = input.bool(true, "Show Pivot Labels",    group="Zigzag")
i_showFibs     = input.bool(true, "Show Fib Levels",      group="Zigzag")

// Pattern
i_hhhlFilter   = input.bool(true, "HH/HL Filter (Bull)", group="Pattern")
i_lhllFilter   = input.bool(true, "LH/LL Filter (Bear)", group="Pattern")
i_minSwingATR  = input.float(1.0, "Min Swing Size (ATR)", group="Pattern", step=0.1)

// Entry
i_entryMode    = input.string("Golden Pocket", "Entry Mode", group="Entry", options=["Golden Pocket", "Break of Structure", "Fib Retrace", "Immediate"])
i_fibEntry     = input.float(0.618,"Fib Entry Level",    group="Entry", step=0.01)
i_atrLen       = input.int(14,    "ATR Length",           group="Entry", minval=1)

// TP/SL
i_slMode       = input.string("Fib Invalidation", "SL Mode", group="TP/SL", options=["Fib Invalidation", "Swing Level", "ATR Based"])
i_slATRMult    = input.float(1.5, "SL ATR Mult",         group="TP/SL", step=0.1)
i_tpMode       = input.string("Fib Extension", "TP Mode", group="TP/SL", options=["Fib Extension", "ATR Based", "R:R Based"])
i_tpFibExt     = input.float(1.618,"TP Fib Extension",   group="TP/SL", step=0.01)
i_tpATRMult    = input.float(2.5, "TP ATR Mult",         group="TP/SL", step=0.1)
i_tpRR         = input.float(2.0, "TP R:R Ratio",        group="TP/SL", step=0.1)

// Session
i_useSession   = input.bool(true, "Session Filter",      group="Session")

// ── ZIGZAG ENGINE ────────────────────────────────────────────
var float[] zzPrices = array.new_float(0)
var int[]   zzBars   = array.new_int(0)
var int[]   zzDirs   = array.new_int(0)  // 1=high, -1=low
var int     zzDir    = 0

isHigh = high == ta.highest(high, i_zzLen)
isLow  = low  == ta.lowest(low, i_zzLen)
atrVal = ta.atr(i_atrLen)

newZZPivot = false
zzPrice    = 0.0
zzBar      = 0
zzPDir     = 0

if isHigh and not isLow
    if zzDir != 1
        if array.size(zzPrices) > 0 or zzDir == 0
            zzPrice := high
            zzBar   := bar_index
            zzPDir  := 1
            newZZPivot := true
        zzDir := 1
    else if array.size(zzPrices) > 0 and high > array.get(zzPrices, 0) and array.get(zzDirs, 0) == 1
        array.set(zzPrices, 0, high)
        array.set(zzBars, 0, bar_index)

if isLow and not isHigh
    if zzDir != -1
        if array.size(zzPrices) > 0 or zzDir == 0
            zzPrice := low
            zzBar   := bar_index
            zzPDir  := -1
            newZZPivot := true
        zzDir := -1
    else if array.size(zzPrices) > 0 and low < array.get(zzPrices, 0) and array.get(zzDirs, 0) == -1
        array.set(zzPrices, 0, low)
        array.set(zzBars, 0, bar_index)

if newZZPivot
    array.unshift(zzPrices, zzPrice)
    array.unshift(zzBars, zzBar)
    array.unshift(zzDirs, zzPDir)
    while array.size(zzPrices) > i_maxPivots
        array.pop(zzPrices)
        array.pop(zzBars)
        array.pop(zzDirs)

// ── PATTERN CLASSIFICATION (HH/HL/LH/LL) ────────────────────
var int pivotPattern = 0  // 1=bullish (HH+HL), -1=bearish (LH+LL)

if array.size(zzPrices) >= 4
    p0 = array.get(zzPrices, 0)
    p1 = array.get(zzPrices, 1)
    p2 = array.get(zzPrices, 2)
    p3 = array.get(zzPrices, 3)
    d0 = array.get(zzDirs, 0)

    if d0 == 1
        isHH = p0 > p2
        isHL = p1 > p3
        pivotPattern := isHH and isHL ? 1 : 0
    if d0 == -1
        isLH = p1 < p3
        isLL = p0 < p2
        pivotPattern := isLH and isLL ? -1 : 0

// ── BOS DETECTION ────────────────────────────────────────────
// Bullish BOS: price breaks above the last LH during bearish structure
//   Impulse = last LL to BOS bar high
// Bearish BOS: price breaks below the last HL during bullish structure
//   Impulse = last HH to BOS bar low

var bool  bosDetected   = false
var int   bosDirection  = 0   // 1=bull, -1=bear
var float bosImpulseTop = na
var float bosImpulseBot = na
var int   bosBar        = 0

bosDetected := false

// Find last relevant swing levels for BOS check
if array.size(zzPrices) >= 6
    // We need enough pivots to identify structure and a BOS break
    // Check for bullish BOS: find the last LH in a bearish sequence, check if current bar broke it
    float lastLH = na
    float lastLL = na
    float lastHL = na
    float lastHH = na
    int   lastLH_bar = 0
    int   lastLL_bar = 0
    int   lastHL_bar = 0
    int   lastHH_bar = 0

    for i = 0 to math.min(array.size(zzPrices) - 1, 9)
        float prc = array.get(zzPrices, i)
        int   dir = array.get(zzDirs, i)
        int   br  = array.get(zzBars, i)
        if dir == 1  // high pivot
            if i + 2 < array.size(zzPrices)
                float prevHigh = na
                // Find previous high pivot
                for j = i + 1 to math.min(array.size(zzPrices) - 1, i + 4)
                    if array.get(zzDirs, j) == 1
                        prevHigh := array.get(zzPrices, j)
                        break
                if not na(prevHigh)
                    if prc < prevHigh and na(lastLH)
                        lastLH     := prc
                        lastLH_bar := br
                    if prc > prevHigh and na(lastHH)
                        lastHH     := prc
                        lastHH_bar := br
        if dir == -1  // low pivot
            if i + 2 < array.size(zzPrices)
                float prevLow = na
                for j = i + 1 to math.min(array.size(zzPrices) - 1, i + 4)
                    if array.get(zzDirs, j) == -1
                        prevLow := array.get(zzPrices, j)
                        break
                if not na(prevLow)
                    if prc < prevLow and na(lastLL)
                        lastLL     := prc
                        lastLL_bar := br
                    if prc > prevLow and na(lastHL)
                        lastHL     := prc
                        lastHL_bar := br

    // Bullish BOS: close breaks above lastLH
    if not na(lastLH) and not na(lastLL) and close > lastLH and close[1] <= lastLH
        bosDetected    := true
        bosDirection   := 1
        bosImpulseBot  := lastLL
        bosImpulseTop  := high
        bosBar         := bar_index

    // Bearish BOS: close breaks below lastHL
    if not na(lastHL) and not na(lastHH) and close < lastHL and close[1] >= lastHL
        bosDetected    := true
        bosDirection   := -1
        bosImpulseTop  := lastHH
        bosImpulseBot  := low
        bosBar         := bar_index

// ── SIGNALS ──────────────────────────────────────────────────
inSession = i_useSession ? (hour(time, "UTC") >= 7 and hour(time, "UTC") <= 21) : true

var bool  buySignal  = false
var bool  sellSignal = false
var float buySL      = na
var float buyTP      = na
var float sellSL     = na
var float sellTP     = na
var float gpTop      = na
var float gpBot      = na
var int   gpDir      = 0

buySignal  := false
sellSignal := false

if bosDetected and inSession
    impulseRange = math.abs(bosImpulseTop - bosImpulseBot)
    validSize    = impulseRange >= atrVal * i_minSwingATR

    if validSize
        // --- BULLISH BOS ---
        if bosDirection == 1
            fib50   = bosImpulseTop - impulseRange * 0.5
            fib618  = bosImpulseTop - impulseRange * 0.618
            fib786  = bosImpulseTop - impulseRange * 0.786
            ext1272 = bosImpulseBot + impulseRange * 1.272
            ext1618 = bosImpulseBot + impulseRange * 1.618
            ext200  = bosImpulseBot + impulseRange * 2.0

            // Entry at golden pocket (0.5-0.618 retrace of impulse)
            gpTop := fib50
            gpBot := fib618
            gpDir := 1

            // SL
            if i_slMode == "Fib Invalidation"
                buySL := fib786
            else if i_slMode == "Swing Level"
                buySL := bosImpulseBot - atrVal * 0.2
            else
                buySL := close - atrVal * i_slATRMult

            // TP
            if i_tpMode == "Fib Extension"
                buyTP := ext1618
            else if i_tpMode == "ATR Based"
                buyTP := close + atrVal * i_tpATRMult
            else
                buyTP := close + math.abs(close - buySL) * i_tpRR

            buySignal := true

            // Draw BOS marker
            label.new(bosBar, high, "BOS", color=color.new(color.lime, 40), textcolor=color.white, style=label.style_label_down, size=size.tiny)

            if i_showFibs
                int fibLen = 40
                line.new(bosBar, fib50,   bosBar + fibLen, fib50,   color=color.new(#FFD700, 30), width=1, style=line.style_dashed)
                line.new(bosBar, fib618,  bosBar + fibLen, fib618,  color=color.new(color.green, 30), width=1, style=line.style_dashed)
                line.new(bosBar, fib786,  bosBar + fibLen, fib786,  color=color.new(color.red, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext1272, bosBar + fibLen, ext1272, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext1618, bosBar + fibLen, ext1618, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext200,  bosBar + fibLen, ext200,  color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                label.new(bosBar + fibLen, fib50,   "0.5",   color=color.new(#FFD700, 80), textcolor=#FFD700,    size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, fib618,  "0.618", color=color.new(color.green, 80), textcolor=color.green, size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, fib786,  "0.786", color=color.new(color.red, 80), textcolor=color.red,   size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext1272, "1.272", color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext1618, "1.618", color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext200,  "2.0",   color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)

        // --- BEARISH BOS ---
        if bosDirection == -1
            fib50   = bosImpulseBot + impulseRange * 0.5
            fib618  = bosImpulseBot + impulseRange * 0.618
            fib786  = bosImpulseBot + impulseRange * 0.786
            ext1272 = bosImpulseTop - impulseRange * 1.272
            ext1618 = bosImpulseTop - impulseRange * 1.618
            ext200  = bosImpulseTop - impulseRange * 2.0

            gpTop := fib618
            gpBot := fib50
            gpDir := -1

            if i_slMode == "Fib Invalidation"
                sellSL := fib786
            else if i_slMode == "Swing Level"
                sellSL := bosImpulseTop + atrVal * 0.2
            else
                sellSL := close + atrVal * i_slATRMult

            if i_tpMode == "Fib Extension"
                sellTP := ext1618
            else if i_tpMode == "ATR Based"
                sellTP := close - atrVal * i_tpATRMult
            else
                sellTP := close - math.abs(sellSL - close) * i_tpRR

            sellSignal := true

            label.new(bosBar, low, "BOS", color=color.new(color.red, 40), textcolor=color.white, style=label.style_label_up, size=size.tiny)

            if i_showFibs
                int fibLen = 40
                line.new(bosBar, fib50,   bosBar + fibLen, fib50,   color=color.new(#FFD700, 30), width=1, style=line.style_dashed)
                line.new(bosBar, fib618,  bosBar + fibLen, fib618,  color=color.new(color.green, 30), width=1, style=line.style_dashed)
                line.new(bosBar, fib786,  bosBar + fibLen, fib786,  color=color.new(color.red, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext1272, bosBar + fibLen, ext1272, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext1618, bosBar + fibLen, ext1618, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(bosBar, ext200,  bosBar + fibLen, ext200,  color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                label.new(bosBar + fibLen, fib50,   "0.5",   color=color.new(#FFD700, 80), textcolor=#FFD700,    size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, fib618,  "0.618", color=color.new(color.green, 80), textcolor=color.green, size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, fib786,  "0.786", color=color.new(color.red, 80), textcolor=color.red,   size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext1272, "1.272", color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext1618, "1.618", color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)
                label.new(bosBar + fibLen, ext200,  "2.0",   color=color.new(color.blue, 80), textcolor=color.blue,  size=size.tiny, style=label.style_label_left)

// ── VISUALS ──────────────────────────────────────────────────
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// Golden pocket bgcolor
inGoldenPocket = (gpDir == 1 and close >= gpBot and close <= gpTop) or (gpDir == -1 and close >= gpBot and close <= gpTop)
bgcolor(inGoldenPocket ? color.new(color.orange, 90) : na, title="Golden Pocket Zone")

// Draw zigzag on last bar
if barstate.islast and i_showZZ and array.size(zzPrices) >= 2
    for idx = 0 to math.min(array.size(zzPrices) - 2, 15)
        p1Price = array.get(zzPrices, idx)
        p2Price = array.get(zzPrices, idx + 1)
        p1Bar   = array.get(zzBars, idx)
        p2Bar   = array.get(zzBars, idx + 1)
        lineCol = p1Price > p2Price ? color.new(color.red, 30) : color.new(color.lime, 30)
        line.new(p1Bar, p1Price, p2Bar, p2Price, color=lineCol, width=1)

        if i_showLabels
            d = array.get(zzDirs, idx)
            // Classify as HH/HL/LH/LL
            string lblTxt = d == 1 ? "H" : "L"
            if idx + 2 < array.size(zzPrices)
                float prevSame = na
                for j = idx + 1 to math.min(array.size(zzPrices) - 1, idx + 3)
                    if array.get(zzDirs, j) == d
                        prevSame := array.get(zzPrices, j)
                        break
                if not na(prevSame)
                    if d == 1
                        lblTxt := p1Price > prevSame ? "HH" : "LH"
                    else
                        lblTxt := p1Price > prevSame ? "HL" : "LL"

            lblStyle = d == 1 ? label.style_label_down : label.style_label_up
            lblColor = d == 1 ? (str.contains(lblTxt, "HH") ? color.new(color.lime, 40) : color.new(color.red, 60)) : (str.contains(lblTxt, "HL") ? color.new(color.lime, 40) : color.new(color.red, 60))
            label.new(p1Bar, p1Price, lblTxt, color=lblColor, textcolor=color.white, style=lblStyle, size=size.tiny)

// TP/SL lines
if buySignal
    line.new(bar_index, buyTP, bar_index + 20, buyTP, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    line.new(bar_index, buySL, bar_index + 20, buySL, color=color.new(color.red, 30), width=2, style=line.style_dashed)

if sellSignal
    line.new(bar_index, sellTP, bar_index + 20, sellTP, color=color.new(color.red, 30), width=2, style=line.style_dashed)
    line.new(bar_index, sellSL, bar_index + 20, sellSL, color=color.new(color.lime, 30), width=2, style=line.style_dashed)

// Info table
var table tbl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "ZZ Sniper", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "BOS+Fib", text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "Entry", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 1, i_entryMode, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Pivots", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(array.size(zzPrices)), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Pattern", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, pivotPattern == 1 ? "BULL" : pivotPattern == -1 ? "BEAR" : "FLAT", text_color=pivotPattern == 1 ? color.lime : pivotPattern == -1 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 4, "ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(atrVal, "#.#####"), text_color=color.white, text_size=size.tiny)
