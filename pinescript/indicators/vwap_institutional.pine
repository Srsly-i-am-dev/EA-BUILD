//@version=5
indicator("VWAP Institutional Stack", shorttitle="VWAPInst", overlay=true, max_lines_count=500, max_labels_count=500)

// ── INPUTS ───────────────────────────────────────────────────
// VWAP Settings
i_showDaily   = input.bool(true, "Show Daily VWAP",   group="VWAP Levels")
i_showWeekly  = input.bool(true, "Show Weekly VWAP",  group="VWAP Levels")
i_showMonthly = input.bool(true, "Show Monthly VWAP", group="VWAP Levels")

// Standard Deviation Bands
i_showBands   = input.bool(true, "Show SD Bands",     group="Bands")
i_sdMult1     = input.float(1.0, "SD Band 1 Mult",    group="Bands", minval=0.1, step=0.1)
i_sdMult2     = input.float(2.0, "SD Band 2 Mult",    group="Bands", minval=0.1, step=0.1)

// Volume
i_volLen      = input.int(20, "Volume MA Length",      group="Volume", minval=1)

// Entry
i_rejWickRatio = input.float(0.6, "Rejection Wick Ratio", group="Entry", minval=0.1, maxval=0.9, step=0.1)

// Colors
i_dailyCol    = input.color(color.blue,    "Daily VWAP",   group="Colors")
i_weeklyCol   = input.color(color.purple,  "Weekly VWAP",  group="Colors")
i_monthlyCol  = input.color(color.orange,  "Monthly VWAP", group="Colors")

// ── VWAP CALCULATIONS ───────────────────────────────────────
// Daily VWAP with standard deviation
dailyVwap = ta.vwap(hlc3)

// Calculate daily VWAP standard deviation manually
cumVol    = ta.cum(volume)
cumVolSrc = ta.cum(hlc3 * volume)
cumVolSq  = ta.cum(hlc3 * hlc3 * volume)
dailyMean = cumVolSrc / cumVol
dailyVar  = cumVolSq / cumVol - dailyMean * dailyMean
dailySD   = math.sqrt(math.max(dailyVar, 0))

dailyUpper1 = dailyVwap + dailySD * i_sdMult1
dailyLower1 = dailyVwap - dailySD * i_sdMult1
dailyUpper2 = dailyVwap + dailySD * i_sdMult2
dailyLower2 = dailyVwap - dailySD * i_sdMult2

// Weekly and Monthly VWAP via request.security
weeklyVwap  = request.security(syminfo.tickerid, "W", ta.vwap(hlc3))
monthlyVwap = request.security(syminfo.tickerid, "M", ta.vwap(hlc3))

// ── VOLUME ANALYSIS ──────────────────────────────────────────
volMA   = ta.sma(volume, i_volLen)
highVol = volume > volMA * 1.5

// ── ENTRY CHECKLIST (3 Confirmations) ────────────────────────
// Confirmation 1: Price Action Signal (rejection candle at VWAP)
bodySize = math.abs(close - open)
fullRange = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// Bullish rejection: long lower wick at VWAP level
bullRejection = lowerWick > fullRange * i_rejWickRatio and close > open and math.abs(low - dailyVwap) < dailySD * 0.3
// Bearish rejection: long upper wick at VWAP level
bearRejection = upperWick > fullRange * i_rejWickRatio and close < open and math.abs(high - dailyVwap) < dailySD * 0.3

// Confirmation 2: Volume above average
volConfirm = highVol

// Confirmation 3: Multi-TF VWAP Stack alignment
bullStack = close > weeklyVwap and close > monthlyVwap   // Price above both = bullish
bearStack = close < weeklyVwap and close < monthlyVwap   // Price below both = bearish

// ── SIGNALS ──────────────────────────────────────────────────
buySignal  = bullRejection and volConfirm and bullStack
sellSignal = bearRejection and volConfirm and bearStack

// Mean reversion signals at +/-2 SD
meanRevBuy  = close <= dailyLower2 and bullStack and volConfirm
meanRevSell = close >= dailyUpper2 and bearStack and volConfirm

// ── TP/SL ────────────────────────────────────────────────────
// SL: at -2 SD band (long) or +2 SD band (short)
buySL  = dailyLower2
buyTP  = dailyUpper1   // Target: opposite SD band

sellSL = dailyUpper2
sellTP = dailyLower1

// ── VISUALS ──────────────────────────────────────────────────
// VWAP lines
plot(i_showDaily ? dailyVwap : na, "Daily VWAP", i_dailyCol, 2)
plot(i_showWeekly ? weeklyVwap : na, "Weekly VWAP", i_weeklyCol, 2, plot.style_stepline)
plot(i_showMonthly ? monthlyVwap : na, "Monthly VWAP", i_monthlyCol, 2, plot.style_stepline)

// SD Bands
p_u1 = plot(i_showBands ? dailyUpper1 : na, "SD +1", color.new(color.gray, 50), 1, plot.style_linebr)
p_l1 = plot(i_showBands ? dailyLower1 : na, "SD -1", color.new(color.gray, 50), 1, plot.style_linebr)
p_u2 = plot(i_showBands ? dailyUpper2 : na, "SD +2", color.new(color.red, 50), 1, plot.style_linebr)
p_l2 = plot(i_showBands ? dailyLower2 : na, "SD -2", color.new(color.green, 50), 1, plot.style_linebr)

fill(p_u1, p_l1, color=color.new(i_dailyCol, 93), title="SD 1 Fill")

// Signals
plotshape(buySignal,  "Buy VWAP",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell VWAP", shape.triangledown,  location.abovebar, color.red,  size=size.small)
plotshape(meanRevBuy,  "Mean Rev Buy",  shape.diamond, location.belowbar, color.new(color.lime, 30), size=size.tiny)
plotshape(meanRevSell, "Mean Rev Sell", shape.diamond, location.abovebar, color.new(color.red, 30), size=size.tiny)

// Volume bars
bgcolor(highVol ? color.new(color.yellow, 90) : na, title="High Volume")

// ── STACK TABLE ──────────────────────────────────────────────
var table stackTbl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(stackTbl, 0, 0, "VWAP Stack", text_color=color.white, text_size=size.small)
    table.cell(stackTbl, 1, 0, bullStack ? "BULLISH" : bearStack ? "BEARISH" : "MIXED", text_color=bullStack ? color.lime : bearStack ? color.red : color.gray, text_size=size.small)
    table.cell(stackTbl, 0, 1, "Daily", text_color=color.gray, text_size=size.tiny)
    table.cell(stackTbl, 1, 1, close > dailyVwap ? "Above" : "Below", text_color=close > dailyVwap ? color.lime : color.red, text_size=size.tiny)
    table.cell(stackTbl, 0, 2, "Weekly", text_color=color.gray, text_size=size.tiny)
    table.cell(stackTbl, 1, 2, close > weeklyVwap ? "Above" : "Below", text_color=close > weeklyVwap ? color.lime : color.red, text_size=size.tiny)
    table.cell(stackTbl, 0, 3, "Monthly", text_color=color.gray, text_size=size.tiny)
    table.cell(stackTbl, 1, 3, close > monthlyVwap ? "Above" : "Below", text_color=close > monthlyVwap ? color.lime : color.red, text_size=size.tiny)
    table.cell(stackTbl, 0, 4, "Volume", text_color=color.gray, text_size=size.tiny)
    table.cell(stackTbl, 1, 4, highVol ? "HIGH" : "Normal", text_color=highVol ? color.yellow : color.gray, text_size=size.tiny)

// ── ALERTS ───────────────────────────────────────────────────
alertcondition(buySignal,     "VWAP Institutional BUY")
alertcondition(sellSignal,    "VWAP Institutional SELL")
alertcondition(meanRevBuy,    "Mean Reversion BUY at -2 SD")
alertcondition(meanRevSell,   "Mean Reversion SELL at +2 SD")
