//@version=5
indicator("DIY Confluence Builder", shorttitle="DIYConf", overlay=true, max_labels_count=500, max_lines_count=500)

// ── LEADING INDICATOR ────────────────────────────────────────
i_leadingType  = input.string("Supertrend", "Leading Indicator", group="Leading",
     options=["Supertrend", "2 EMA Cross", "3 EMA Cross", "MACD", "RSI", "Stochastic", "Hull Suite", "Donchian", "Range Filter", "Half Trend", "VWAP"])

// Leading params
i_stFactor     = input.float(3.0,  "Supertrend Factor",   group="Leading", step=0.1)
i_stPeriod     = input.int(10,     "Supertrend Period",    group="Leading", minval=1)
i_ema2Fast     = input.int(50,     "2EMA Fast",            group="Leading", minval=1)
i_ema2Slow     = input.int(200,    "2EMA Slow",            group="Leading", minval=1)
i_ema3A        = input.int(9,      "3EMA A",               group="Leading", minval=1)
i_ema3B        = input.int(21,     "3EMA B",               group="Leading", minval=1)
i_ema3C        = input.int(55,     "3EMA C",               group="Leading", minval=1)
i_macdFast     = input.int(12,     "MACD Fast",            group="Leading", minval=1)
i_macdSlow     = input.int(26,     "MACD Slow",            group="Leading", minval=1)
i_macdSignal   = input.int(9,      "MACD Signal",          group="Leading", minval=1)
i_rsiLen       = input.int(14,     "RSI Length",            group="Leading", minval=1)
i_rsiOB        = input.int(70,     "RSI Overbought",        group="Leading", minval=50, maxval=100)
i_rsiOS        = input.int(30,     "RSI Oversold",           group="Leading", minval=0, maxval=50)
i_stochK       = input.int(14,     "Stoch K",               group="Leading", minval=1)
i_stochD       = input.int(3,      "Stoch D",               group="Leading", minval=1)
i_stochSmooth  = input.int(3,      "Stoch Smooth",          group="Leading", minval=1)
i_hullLen      = input.int(55,     "Hull Length",            group="Leading", minval=1)
i_donchLen     = input.int(20,     "Donchian Length",        group="Leading", minval=1)

// ── CONFIRMATION FILTERS ─────────────────────────────────────
i_useEMAFilter  = input.bool(true,  "EMA 200 Filter",       group="Confirmation")
i_emaFilterLen  = input.int(200,    "EMA Filter Length",     group="Confirmation", minval=1)
i_useADX        = input.bool(false, "ADX Filter",            group="Confirmation")
i_adxLen        = input.int(14,     "ADX Length",             group="Confirmation", minval=1)
i_adxThresh     = input.int(25,     "ADX Threshold",          group="Confirmation", minval=1)
i_useVolume     = input.bool(false, "Volume Filter",          group="Confirmation")
i_volLen        = input.int(20,     "Volume MA Length",        group="Confirmation", minval=1)
i_useATRFilter  = input.bool(false, "ATR Volatility Filter",  group="Confirmation")
i_atrFilterLen  = input.int(14,     "ATR Filter Length",       group="Confirmation", minval=1)
i_atrFilterMult = input.float(0.8,  "ATR Min Ratio",           group="Confirmation", step=0.1)
i_useSession    = input.bool(true,  "Session Filter",          group="Confirmation")
i_sessionStart  = input.int(7,      "Session Start UTC",       group="Confirmation", minval=0, maxval=23)
i_sessionEnd    = input.int(21,     "Session End UTC",         group="Confirmation", minval=0, maxval=23)

// ── SETUP ────────────────────────────────────────────────────
i_signalExpiry  = input.int(3,      "Signal Expiry (bars)", group="Setup", minval=1, maxval=20)
i_alternateOnly = input.bool(true,  "Alternate Signals",   group="Setup")
i_showDash      = input.bool(true,  "Show Dashboard",      group="Setup")

// TP/SL
i_atrLen        = input.int(14,     "ATR Length",           group="TP/SL", minval=1)
i_slATRMult     = input.float(1.5,  "SL ATR Mult",         group="TP/SL", step=0.1)
i_tpATRMult     = input.float(2.5,  "TP ATR Mult",         group="TP/SL", step=0.1)

// ── INDICATOR CALCULATIONS ───────────────────────────────────
atrVal = ta.atr(i_atrLen)

// Supertrend
[stUp, stDir] = ta.supertrend(i_stFactor, i_stPeriod)
stLong  = stDir < 0
stShort = stDir > 0

// 2 EMA Cross
ema2F = ta.ema(close, i_ema2Fast)
ema2S = ta.ema(close, i_ema2Slow)
ema2Long  = ema2F > ema2S
ema2Short = ema2F < ema2S

// 3 EMA Cross
ema3A = ta.ema(close, i_ema3A)
ema3B = ta.ema(close, i_ema3B)
ema3C = ta.ema(close, i_ema3C)
ema3Long  = ema3A > ema3B and ema3B > ema3C
ema3Short = ema3A < ema3B and ema3B < ema3C

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)
macdLong  = macdLine > signalLine
macdShort = macdLine < signalLine

// RSI
rsiVal   = ta.rsi(close, i_rsiLen)
rsiLong  = rsiVal < i_rsiOS
rsiShort = rsiVal > i_rsiOB

// Stochastic
stochK = ta.sma(ta.stoch(close, high, low, i_stochK), i_stochSmooth)
stochD = ta.sma(stochK, i_stochD)
stochLong  = ta.crossover(stochK, stochD) and stochK < 20
stochShort = ta.crossunder(stochK, stochD) and stochK > 80

// Hull Suite
hullMA    = ta.wma(2 * ta.wma(close, i_hullLen / 2) - ta.wma(close, i_hullLen), math.round(math.sqrt(i_hullLen)))
hullLong  = close > hullMA
hullShort = close < hullMA

// Donchian
donchUp   = ta.highest(high, i_donchLen)
donchDn   = ta.lowest(low, i_donchLen)
donchLong = close >= donchUp[1]
donchShort = close <= donchDn[1]

// Range Filter (simplified)
rfSmooth  = ta.ema(close, 27)
rfRange   = ta.ema(ta.atr(27) * 2.618, 27)
rfUp      = close > rfSmooth + rfRange
rfDown    = close < rfSmooth - rfRange

// Half Trend (simplified)
htHigh  = ta.highest(low, 2)
htLow   = ta.lowest(high, 2)
var int htDir = 0
if close > htHigh[1]
    htDir := 1
if close < htLow[1]
    htDir := -1
htLong  = htDir == 1
htShort = htDir == -1

// VWAP
dailyVwap = ta.vwap(hlc3)
vwapLong  = close > dailyVwap
vwapShort = close < dailyVwap

// ── LEADING SIGNAL ───────────────────────────────────────────
leadLong  = false
leadShort = false

if i_leadingType == "Supertrend"
    leadLong  := stLong and not stLong[1]
    leadShort := stShort and not stShort[1]
else if i_leadingType == "2 EMA Cross"
    leadLong  := ta.crossover(ema2F, ema2S)
    leadShort := ta.crossunder(ema2F, ema2S)
else if i_leadingType == "3 EMA Cross"
    leadLong  := ema3Long and not ema3Long[1]
    leadShort := ema3Short and not ema3Short[1]
else if i_leadingType == "MACD"
    leadLong  := ta.crossover(macdLine, signalLine)
    leadShort := ta.crossunder(macdLine, signalLine)
else if i_leadingType == "RSI"
    leadLong  := ta.crossover(rsiVal, i_rsiOS)
    leadShort := ta.crossunder(rsiVal, i_rsiOB)
else if i_leadingType == "Stochastic"
    leadLong  := stochLong
    leadShort := stochShort
else if i_leadingType == "Hull Suite"
    leadLong  := hullLong and not hullLong[1]
    leadShort := hullShort and not hullShort[1]
else if i_leadingType == "Donchian"
    leadLong  := donchLong
    leadShort := donchShort
else if i_leadingType == "Range Filter"
    leadLong  := rfUp and not rfUp[1]
    leadShort := rfDown and not rfDown[1]
else if i_leadingType == "Half Trend"
    leadLong  := htLong and not htLong[1]
    leadShort := htShort and not htShort[1]
else if i_leadingType == "VWAP"
    leadLong  := ta.crossover(close, dailyVwap)
    leadShort := ta.crossunder(close, dailyVwap)

// ── SIGNAL EXPIRY ────────────────────────────────────────────
var int leadLongCount  = 0
var int leadShortCount = 0

if leadLong
    leadLongCount := i_signalExpiry
if leadShort
    leadShortCount := i_signalExpiry

leadLongActive  = leadLongCount > 0
leadShortActive = leadShortCount > 0

leadLongCount  := math.max(0, leadLongCount - 1)
leadShortCount := math.max(0, leadShortCount - 1)

// ── CONFIRMATION ─────────────────────────────────────────────
emaFilter    = ta.ema(close, i_emaFilterLen)
emaLong      = not i_useEMAFilter or close > emaFilter
emaShort     = not i_useEMAFilter or close < emaFilter

[diPlus, diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)
adxOK        = not i_useADX or adxVal >= i_adxThresh

volMA        = ta.sma(volume, i_volLen)
volOK        = not i_useVolume or volume > volMA

atrFilter    = ta.atr(i_atrFilterLen)
atrFilterMA  = ta.sma(atrFilter, 50)
atrOK        = not i_useATRFilter or (atrFilterMA > 0 ? atrFilter / atrFilterMA >= i_atrFilterMult : true)

currentHour  = hour(time, "UTC")
sessionOK    = not i_useSession or (currentHour >= i_sessionStart and currentHour <= i_sessionEnd)

confLong  = emaLong and adxOK and volOK and atrOK and sessionOK
confShort = emaShort and adxOK and volOK and atrOK and sessionOK

// ── FINAL SIGNALS ────────────────────────────────────────────
longCond  = leadLongActive and confLong
shortCond = leadShortActive and confShort

var int condIni = 0
if longCond
    condIni := 1
if shortCond
    condIni := -1

buySignal  = longCond and (not i_alternateOnly or condIni[1] == -1 or condIni[1] == 0)
sellSignal = shortCond and (not i_alternateOnly or condIni[1] == 1 or condIni[1] == 0)

// TP/SL
float buySL  = close - atrVal * i_slATRMult
float buyTP  = close + atrVal * i_tpATRMult
float sellSL = close + atrVal * i_slATRMult
float sellTP = close - atrVal * i_tpATRMult

// ── VISUALS ──────────────────────────────────────────────────
plot(i_useEMAFilter ? emaFilter : na, "EMA Filter", color.gray, 1)
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

if buySignal
    line.new(bar_index, buyTP, bar_index + 20, buyTP, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    line.new(bar_index, buySL, bar_index + 20, buySL, color=color.new(color.red, 30), width=2, style=line.style_dashed)
if sellSignal
    line.new(bar_index, sellTP, bar_index + 20, sellTP, color=color.new(color.red, 30), width=2, style=line.style_dashed)
    line.new(bar_index, sellSL, bar_index + 20, sellSL, color=color.new(color.lime, 30), width=2, style=line.style_dashed)

// ── DASHBOARD ────────────────────────────────────────────────
if i_showDash
    var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
    if barstate.islast
        table.cell(dash, 0, 0, "DIY Builder", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 0, i_leadingType, text_color=color.yellow, text_size=size.small)
        table.cell(dash, 0, 1, "Leading", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 1, leadLongActive ? "LONG" : leadShortActive ? "SHORT" : "NONE", text_color=leadLongActive ? color.lime : leadShortActive ? color.red : color.gray, text_size=size.tiny)
        table.cell(dash, 0, 2, "EMA 200", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 2, not i_useEMAFilter ? "OFF" : emaLong ? "BULL" : "BEAR", text_color=not i_useEMAFilter ? color.gray : emaLong ? color.lime : color.red, text_size=size.tiny)
        table.cell(dash, 0, 3, "ADX", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 3, not i_useADX ? "OFF" : adxOK ? "PASS" : "FAIL", text_color=not i_useADX ? color.gray : adxOK ? color.lime : color.red, text_size=size.tiny)
        table.cell(dash, 0, 4, "Volume", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 4, not i_useVolume ? "OFF" : volOK ? "PASS" : "FAIL", text_color=not i_useVolume ? color.gray : volOK ? color.lime : color.red, text_size=size.tiny)
        table.cell(dash, 0, 5, "ATR Vol", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 5, not i_useATRFilter ? "OFF" : atrOK ? "PASS" : "FAIL", text_color=not i_useATRFilter ? color.gray : atrOK ? color.lime : color.red, text_size=size.tiny)
        table.cell(dash, 0, 6, "Session", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 6, not i_useSession ? "OFF" : sessionOK ? "ACTIVE" : "CLOSED", text_color=not i_useSession ? color.gray : sessionOK ? color.lime : color.red, text_size=size.tiny)
        table.cell(dash, 0, 7, "Signal", text_color=color.gray, text_size=size.tiny)
        table.cell(dash, 1, 7, buySignal ? "BUY" : sellSignal ? "SELL" : "WAIT", text_color=buySignal ? color.lime : sellSignal ? color.red : color.gray, text_size=size.tiny)
