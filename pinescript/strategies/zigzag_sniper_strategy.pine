//@version=5
strategy("Zigzag Sniper [BOS+Fib Strategy]", shorttitle="ZZSniper_strat", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         initial_capital=10000, commission_type=strategy.commission.cash_per_order,
         commission_value=0, slippage=2, pyramiding=0,
         calc_on_every_tick=false, process_orders_on_close=true)

// ── INPUTS ───────────────────────────────────────────────────
i_zzLen       = input.int(5,      "Zigzag Length",         group="Zigzag", minval=2)
i_maxPivots   = input.int(20,     "Max Pivots",            group="Zigzag", minval=5)
i_hhhlFilter  = input.bool(true,  "HH/HL Filter (Bull)",  group="Pattern")
i_lhllFilter  = input.bool(true,  "LH/LL Filter (Bear)",  group="Pattern")
i_minSwingATR = input.float(1.0,  "Min Swing Size (ATR)", group="Pattern", step=0.1)
i_atrLen      = input.int(14,     "ATR Length",            group="Entry", minval=1)
i_tpFibExt    = input.float(1.618,"TP Fib Extension",     group="TP/SL", step=0.01)
i_useSession  = input.bool(true,  "Session Filter",       group="Session")

// ── ZIGZAG ───────────────────────────────────────────────────
var float[] zzP = array.new_float(0)
var int[]   zzB = array.new_int(0)
var int[]   zzD = array.new_int(0)
var int     zzDir = 0

isH = high == ta.highest(high, i_zzLen)
isL = low  == ta.lowest(low, i_zzLen)
atrVal = ta.atr(i_atrLen)

newPiv = false
pP = 0.0
pB = 0
pD = 0

if isH and not isL
    if zzDir != 1
        if array.size(zzP) > 0 or zzDir == 0
            pP := high
            pB := bar_index
            pD := 1
            newPiv := true
        zzDir := 1
    else if array.size(zzP) > 0 and high > array.get(zzP, 0) and array.get(zzD, 0) == 1
        array.set(zzP, 0, high)
        array.set(zzB, 0, bar_index)

if isL and not isH
    if zzDir != -1
        if array.size(zzP) > 0 or zzDir == 0
            pP := low
            pB := bar_index
            pD := -1
            newPiv := true
        zzDir := -1
    else if array.size(zzP) > 0 and low < array.get(zzP, 0) and array.get(zzD, 0) == -1
        array.set(zzP, 0, low)
        array.set(zzB, 0, bar_index)

if newPiv
    array.unshift(zzP, pP)
    array.unshift(zzB, pB)
    array.unshift(zzD, pD)
    while array.size(zzP) > i_maxPivots
        array.pop(zzP)
        array.pop(zzB)
        array.pop(zzD)

// ── BOS DETECTION + ENTRIES ──────────────────────────────────
inSession = i_useSession ? (hour(time, "UTC") >= 7 and hour(time, "UTC") <= 21) : true

if array.size(zzP) >= 6 and inSession
    // Find last LH, LL, HL, HH from zigzag pivots
    float lastLH = na
    float lastLL = na
    float lastHL = na
    float lastHH = na

    for i = 0 to math.min(array.size(zzP) - 1, 9)
        float prc = array.get(zzP, i)
        int   dir = array.get(zzD, i)
        if dir == 1
            if i + 2 < array.size(zzP)
                float prevHigh = na
                for j = i + 1 to math.min(array.size(zzP) - 1, i + 4)
                    if array.get(zzD, j) == 1
                        prevHigh := array.get(zzP, j)
                        break
                if not na(prevHigh)
                    if prc < prevHigh and na(lastLH)
                        lastLH := prc
                    if prc > prevHigh and na(lastHH)
                        lastHH := prc
        if dir == -1
            if i + 2 < array.size(zzP)
                float prevLow = na
                for j = i + 1 to math.min(array.size(zzP) - 1, i + 4)
                    if array.get(zzD, j) == -1
                        prevLow := array.get(zzP, j)
                        break
                if not na(prevLow)
                    if prc < prevLow and na(lastLL)
                        lastLL := prc
                    if prc > prevLow and na(lastHL)
                        lastHL := prc

    // Bullish BOS: close breaks above lastLH
    if not na(lastLH) and not na(lastLL) and close > lastLH and close[1] <= lastLH
        impulseRange = math.abs(high - lastLL)
        validSize = impulseRange >= atrVal * i_minSwingATR
        if validSize
            fib786 = high - impulseRange * 0.786  // SL = 0.786 invalidation
            tp     = lastLL + impulseRange * i_tpFibExt
            strategy.entry("Long", strategy.long)
            strategy.exit("Long Exit", "Long", stop=fib786, limit=tp)

    // Bearish BOS: close breaks below lastHL
    if not na(lastHL) and not na(lastHH) and close < lastHL and close[1] >= lastHL
        impulseRange = math.abs(lastHH - low)
        validSize = impulseRange >= atrVal * i_minSwingATR
        if validSize
            fib786 = low + impulseRange * 0.786  // SL = 0.786 invalidation
            tp     = lastHH - impulseRange * i_tpFibExt
            strategy.entry("Short", strategy.short)
            strategy.exit("Short Exit", "Short", stop=fib786, limit=tp)

// ── VISUALS ──────────────────────────────────────────────────
plot(close, display=display.none)
