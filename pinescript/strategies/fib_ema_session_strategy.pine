//@version=5
strategy("Fib EMA Session BOS [Strategy]", shorttitle="FibSess_BOS_strat", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         initial_capital=10000, commission_type=strategy.commission.cash_per_order,
         commission_value=0, slippage=2, pyramiding=0,
         calc_on_every_tick=false, process_orders_on_close=true)

// ── INPUTS ───────────────────────────────────────────────────
// EMA Trend Filter
i_emaFast        = input.int(50,      "EMA Fast Period",              group="Trend", minval=5)
i_emaSlow        = input.int(200,     "EMA Slow Period",              group="Trend", minval=20)
i_atrPeriod      = input.int(14,      "ATR Period",                   group="Trend", minval=1)

// BOS / Swing
inp_swing_left   = input.int(5,       "Swing Left Bars",              group="BOS", minval=1)
inp_swing_right  = input.int(3,       "Swing Right Bars",             group="BOS", minval=1)
inp_min_impulse  = input.float(0.5,   "Min Impulse (ATR mult)",       group="BOS", minval=0.1, step=0.1)
inp_max_impulse  = input.float(3.0,   "Max Impulse (ATR mult)",       group="BOS", minval=1.0, step=0.1)

// Fibonacci
inp_fib_entry_hi = input.float(0.618, "Fib Entry High (GP Top)",      group="Fibonacci", minval=0.1, maxval=1.0, step=0.001)
inp_fib_entry_lo = input.float(0.500, "Fib Entry Low (GP Bottom)",    group="Fibonacci", minval=0.1, maxval=1.0, step=0.001)
inp_fib_invalid  = input.float(0.786, "Fib Invalidation Level",       group="Fibonacci", minval=0.5, maxval=1.0, step=0.001)

// Session Filter
inp_use_session  = input.bool(true,   "Use Session Filter",           group="Session")
inp_session_start = input.int(7,      "Session Start Hour (UTC)",     group="Session", minval=0, maxval=23)
inp_session_end  = input.int(20,      "Session End Hour (UTC)",       group="Session", minval=0, maxval=23)

// ── CALCULATIONS ─────────────────────────────────────────────
emaFast = ta.ema(close, i_emaFast)
emaSlow = ta.ema(close, i_emaSlow)
atrVal  = ta.atr(i_atrPeriod)

bullishTrend = emaFast > emaSlow
bearishTrend = emaFast < emaSlow

// Session
currentHour   = hour(time, "UTC")
sessionActive = (inp_use_session == false) or (currentHour >= inp_session_start and currentHour < inp_session_end)

// ── BOS STATE VARIABLES ──────────────────────────────────────
var float prevSwingHigh   = na
var float prevSwingLow    = na
var float impulse_lo_bull = na
var float impulse_hi_bull = na
var float impulse_hi_bear = na
var float impulse_lo_bear = na
var bool  bos_bull_active = false
var bool  bos_bear_active = false
var bool  bull_invalidated = false
var bool  bear_invalidated = false

// ── PIVOT DETECTION ──────────────────────────────────────────
swingH = ta.pivothigh(high, inp_swing_left, inp_swing_right)
swingL = ta.pivotlow(low, inp_swing_left, inp_swing_right)

if not na(swingL)
    prevSwingLow    := swingL
    impulse_lo_bull := swingL

if not na(swingH)
    prevSwingHigh   := swingH
    impulse_hi_bear := swingH

// ── BOS DETECTION ────────────────────────────────────────────
bosLong  = not na(prevSwingHigh) and close > prevSwingHigh and not bos_bull_active
bosShort = not na(prevSwingLow)  and close < prevSwingLow  and not bos_bear_active

if bosLong
    impulse_hi_bull  := high
    bos_bull_active  := true
    bos_bear_active  := false
    bull_invalidated := false
    prevSwingHigh    := na

if bosShort
    impulse_lo_bear  := low
    bos_bear_active  := true
    bos_bull_active  := false
    bear_invalidated := false
    prevSwingLow     := na

// ── FIBONACCI ON IMPULSE LEG ─────────────────────────────────
imp_range_bull = (not na(impulse_hi_bull) and not na(impulse_lo_bull)) ? (impulse_hi_bull - impulse_lo_bull) : na
fib_0618_bull  = not na(imp_range_bull) ? impulse_hi_bull - inp_fib_entry_hi * imp_range_bull : na
fib_0500_bull  = not na(imp_range_bull) ? impulse_hi_bull - inp_fib_entry_lo * imp_range_bull : na
fib_0786_bull  = not na(imp_range_bull) ? impulse_hi_bull - inp_fib_invalid  * imp_range_bull : na
fib_1618_bull  = not na(imp_range_bull) ? impulse_hi_bull + 0.618 * imp_range_bull : na

imp_range_bear = (not na(impulse_hi_bear) and not na(impulse_lo_bear)) ? (impulse_hi_bear - impulse_lo_bear) : na
fib_0618_bear  = not na(imp_range_bear) ? impulse_lo_bear + inp_fib_entry_hi * imp_range_bear : na
fib_0500_bear  = not na(imp_range_bear) ? impulse_lo_bear + inp_fib_entry_lo * imp_range_bear : na
fib_0786_bear  = not na(imp_range_bear) ? impulse_lo_bear + inp_fib_invalid  * imp_range_bear : na
fib_1618_bear  = not na(imp_range_bear) ? impulse_lo_bear - 0.618 * imp_range_bear : na

// ── INVALIDATION ─────────────────────────────────────────────
if bos_bull_active and not na(fib_0786_bull) and low < fib_0786_bull
    bull_invalidated := true
    bos_bull_active  := false

if bos_bear_active and not na(fib_0786_bear) and high > fib_0786_bear
    bear_invalidated := true
    bos_bear_active  := false

// ── ATR IMPULSE FILTERS ─────────────────────────────────────
bull_impulse_ok = not na(imp_range_bull) and imp_range_bull > atrVal * inp_min_impulse and imp_range_bull < atrVal * inp_max_impulse
bear_impulse_ok = not na(imp_range_bear) and imp_range_bear > atrVal * inp_min_impulse and imp_range_bear < atrVal * inp_max_impulse

// ── GOLDEN POCKET ENTRY ──────────────────────────────────────
inPocketBull = bos_bull_active and not bull_invalidated and not na(fib_0618_bull) and low <= fib_0500_bull and close >= fib_0618_bull
inPocketBear = bos_bear_active and not bear_invalidated and not na(fib_0618_bear) and high >= fib_0500_bear and close <= fib_0618_bear

longSignal  = inPocketBull and (close > open) and bullishTrend and bull_impulse_ok and sessionActive
shortSignal = inPocketBear and (close < open) and bearishTrend and bear_impulse_ok and sessionActive

// ── SL / TP ──────────────────────────────────────────────────
long_sl  = fib_0786_bull - syminfo.mintick * 10
long_tp  = fib_1618_bull

short_sl  = fib_0786_bear + syminfo.mintick * 10
short_tp  = fib_1618_bear

// ── STRATEGY ENTRIES ─────────────────────────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp)

if shortSignal
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp)

// ── VISUALS ──────────────────────────────────────────────────
plot(emaFast, "EMA 50",  color.blue,   1)
plot(emaSlow, "EMA 200", color.orange, 1)
plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(shortSignal, "Short", shape.triangledown,  location.abovebar, color.red,  size=size.small)
plotshape(bosLong,  "BOS Bull", shape.diamond, location.abovebar, color.new(color.green, 0), size=size.tiny, text="BOS")
plotshape(bosShort, "BOS Bear", shape.diamond, location.belowbar, color.new(color.red, 0),   size=size.tiny, text="BOS")
bgcolor(sessionActive ? na : color.new(color.gray, 95), title="Out of Session")
