//@version=5
strategy("FB-Razor BOS [Strategy]", shorttitle="FBRazor_BOS_strat", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         pyramiding=0, commission_type=strategy.commission.cash_per_order,
         commission_value=0, slippage=2, calc_on_every_tick=false, process_orders_on_close=true)

// ── INPUTS ───────────────────────────────────────────────────
// EMA Trend
inp_ema_fast     = input.int(21,      "EMA Fast",                group="Trend", minval=1)
inp_ema_slow     = input.int(55,      "EMA Slow",                group="Trend", minval=2)

// Swing/Pivot
inp_swing_left   = input.int(10,      "Pivot Left Bars",         group="Pivot", minval=1)
inp_swing_right  = input.int(5,       "Pivot Right Bars",        group="Pivot", minval=1)

// ATR / Impulse
inp_atr_period   = input.int(14,      "ATR Period",              group="Impulse", minval=2)
inp_atr_mult_min = input.float(0.8,   "Min Impulse ATR Multiple",group="Impulse", step=0.1)
inp_atr_mult_max = input.float(3.0,   "Max Impulse ATR Multiple",group="Impulse", step=0.1)

// Fibonacci
inp_fib_entry_hi = input.float(0.618, "Golden Pocket Top",       group="Fibonacci", step=0.01)
inp_fib_entry_lo = input.float(0.500, "Golden Pocket Bottom",    group="Fibonacci", step=0.01)
inp_fib_invalid  = input.float(0.786, "Invalidation Level",      group="Fibonacci", step=0.01)

// Filters
inp_require_ema  = input.bool(true,   "Require EMA Trend Filter",group="Filters")

// ── STATE MACHINE ────────────────────────────────────────────
var int   state              = 0
var int   direction          = 0
var float swing_level        = na
var float impulse_lo         = na
var float impulse_hi         = na
var float impulse_orig_bear  = na
var float impulse_bot_bear   = na
var float prevSwingHigh      = na
var float prevSwingLow       = na
var float last_swing_low_val  = na
var float last_swing_high_val = na

// ── CALCULATIONS ─────────────────────────────────────────────
ema_fast = ta.ema(close, inp_ema_fast)
ema_slow = ta.ema(close, inp_ema_slow)
atr      = ta.atr(inp_atr_period)

trend_bull = ema_fast > ema_slow
trend_bear = ema_fast < ema_slow

swingH = ta.pivothigh(high, inp_swing_left, inp_swing_right)
swingL = ta.pivotlow(low,  inp_swing_left, inp_swing_right)

if not na(swingL)
    prevSwingLow       := swingL
    last_swing_low_val := swingL

if not na(swingH)
    prevSwingHigh       := swingH
    last_swing_high_val := swingH

// ── STATE TRANSITIONS ────────────────────────────────────────

// Idle -> BOS Detected
if state == 0
    // Bullish BOS
    if not na(prevSwingHigh) and close > prevSwingHigh
        imp_range = high - last_swing_low_val
        if not na(last_swing_low_val) and imp_range >= atr * inp_atr_mult_min and imp_range <= atr * inp_atr_mult_max
            if inp_require_ema == false or trend_bull
                state        := 1
                direction    := 1
                impulse_lo   := last_swing_low_val
                impulse_hi   := high
                swing_level  := prevSwingHigh
                prevSwingHigh := na

    // Bearish BOS
    if state == 0 and not na(prevSwingLow) and close < prevSwingLow
        imp_range = last_swing_high_val - low
        if not na(last_swing_high_val) and imp_range >= atr * inp_atr_mult_min and imp_range <= atr * inp_atr_mult_max
            if inp_require_ema == false or trend_bear
                state            := 1
                direction        := -1
                impulse_orig_bear := last_swing_high_val
                impulse_bot_bear  := low
                swing_level       := prevSwingLow
                prevSwingLow      := na

// ── FIB LEVELS ───────────────────────────────────────────────
imp_r_bull = (not na(impulse_hi) and not na(impulse_lo)) ? impulse_hi - impulse_lo : na
f05_bull   = not na(imp_r_bull) ? impulse_hi - 0.500 * imp_r_bull : na
f618_bull  = not na(imp_r_bull) ? impulse_hi - 0.618 * imp_r_bull : na
f786_bull  = not na(imp_r_bull) ? impulse_hi - 0.786 * imp_r_bull : na
f1272_bull = not na(imp_r_bull) ? impulse_hi + 0.272 * imp_r_bull : na
f1618_bull = not na(imp_r_bull) ? impulse_hi + 0.618 * imp_r_bull : na
f2000_bull = not na(imp_r_bull) ? impulse_hi + 1.000 * imp_r_bull : na

imp_r_bear = (not na(impulse_orig_bear) and not na(impulse_bot_bear)) ? impulse_orig_bear - impulse_bot_bear : na
f05_bear   = not na(imp_r_bear) ? impulse_bot_bear + 0.500 * imp_r_bear : na
f618_bear  = not na(imp_r_bear) ? impulse_bot_bear + 0.618 * imp_r_bear : na
f786_bear  = not na(imp_r_bear) ? impulse_bot_bear + 0.786 * imp_r_bear : na
f1272_bear = not na(imp_r_bear) ? impulse_bot_bear - 0.272 * imp_r_bear : na
f1618_bear = not na(imp_r_bear) ? impulse_bot_bear - 0.618 * imp_r_bear : na
f2000_bear = not na(imp_r_bear) ? impulse_bot_bear - 1.000 * imp_r_bear : na

// Invalidation check
if state == 1 or state == 2
    if direction == 1 and not na(f786_bull) and low < f786_bull
        state := 0
    if direction == -1 and not na(f786_bear) and high > f786_bear
        state := 0

// BOS Detected -> Armed (Golden Pocket)
if state == 1
    if direction == 1 and not na(f618_bull) and not na(f05_bull) and low <= f05_bull and close >= f618_bull
        state := 2
    if direction == -1 and not na(f618_bear) and not na(f05_bear) and high >= f05_bear and close <= f618_bear
        state := 2

// ── SIGNALS ──────────────────────────────────────────────────
longSignal  = state == 2 and direction == 1  and close > open
shortSignal = state == 2 and direction == -1 and close < open

if longSignal or shortSignal
    state := 0

// ── SL / TP ─────────────────────────────────────────────────
long_sl  = direction == 1  ? (not na(f786_bull) ? f786_bull - syminfo.mintick * 10 : na) : na
long_tp2 = f1618_bull   // TP2 = 1.618 extension
short_sl  = direction == -1 ? (not na(f786_bear) ? f786_bear + syminfo.mintick * 10 : na) : na
short_tp2 = f1618_bear

// ── STRATEGY ENTRIES / EXITS ─────────────────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp2)

if shortSignal
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp2)

// ── VISUALS ──────────────────────────────────────────────────
plot(ema_fast, "EMA Fast", color.blue, 1)
plot(ema_slow, "EMA Slow", color.orange, 1)
plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(shortSignal, "Short", shape.triangledown,  location.abovebar, color.red,   size=size.normal)
