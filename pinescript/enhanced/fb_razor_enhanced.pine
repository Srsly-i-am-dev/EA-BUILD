//@version=5
indicator("FB Razor Swing", shorttitle="FBRazor", overlay=true, max_labels_count=500, max_lines_count=500)

// ── INPUTS ───────────────────────────────────────────────────
// EMA Trend
i_emaFast        = input.int(21,    "EMA Fast",           group="Trend", minval=1)
i_emaSlow        = input.int(55,    "EMA Slow",           group="Trend", minval=2)
i_slopeLookback  = input.int(10,    "Slope Lookback",     group="Trend", minval=1)
i_minSlopePips   = input.float(0.6, "Min Slope (ATR-norm)", group="Trend", step=0.1)

// Swing/Pivot
i_swingLeft      = input.int(3,     "Swing Pivot Left",   group="Pivot", minval=1)
i_swingRight     = input.int(3,     "Swing Pivot Right",  group="Pivot", minval=1)

// Impulse
i_minImpulseATR  = input.float(2.0, "Min Impulse (ATR mult)", group="Impulse", minval=0.1, step=0.1)
i_maxImpulseBars = input.int(80,    "Max Impulse Bars",   group="Impulse", minval=5)
i_maxCounterBars = input.int(20,    "Max Counter Closes", group="Impulse", minval=0)

// EQH/EQL
i_enableEQHL     = input.bool(true, "Enable EQH/EQL",    group="EQH/EQL")
i_eqTolATR       = input.float(0.3, "EQ Tolerance (ATR)", group="EQH/EQL", step=0.05)
i_eqLookback     = input.int(200,   "EQ Lookback Bars",  group="EQH/EQL", minval=20)
i_requireSweep   = input.bool(true, "Require Sweep",     group="EQH/EQL")
i_sweepATR       = input.float(0.3, "Sweep Break (ATR)", group="EQH/EQL", step=0.05)
i_sweepReclaim   = input.int(15,    "Sweep Reclaim Bars", group="EQH/EQL", minval=1)

// Fibonacci
i_fibMin         = input.float(0.382,"Fib Zone Min",     group="Fibonacci", minval=0.0, maxval=1.0, step=0.01)
i_fibMax         = input.float(0.618,"Fib Zone Max",     group="Fibonacci", minval=0.0, maxval=1.0, step=0.01)
i_invalidation   = input.float(0.786,"Invalidation Level", group="Fibonacci", step=0.01)
i_maxRetraceBars = input.int(60,    "Max Retrace Bars",  group="Fibonacci", minval=5)
i_maxBeyondEMA   = input.int(12,    "Max Closes Beyond EMA", group="Fibonacci", minval=0)

// Entry
i_entryLeft      = input.int(2,     "Entry Pivot Left",  group="Entry", minval=1)
i_entryRight     = input.int(2,     "Entry Pivot Right", group="Entry", minval=1)
i_maxEntryDist   = input.float(2.0, "Max Entry Dist (ATR)", group="Entry", step=0.1)

// TP/SL
i_slBufferATR    = input.float(0.15,"SL Buffer (ATR)",   group="TP/SL", step=0.05)
i_slATRMult      = input.float(1.5, "SL ATR Mult",       group="TP/SL", step=0.1)
i_fibTarget      = input.float(1.272,"Fib Extension",    group="TP/SL", step=0.01)
i_tpATRMult      = input.float(2.2, "TP ATR Mult",       group="TP/SL", step=0.1)

// Volatility Regime
i_volATR         = input.int(14,    "Vol ATR Period",     group="Vol Regime", minval=2)
i_volMA          = input.int(50,    "Vol MA Period",      group="Vol Regime", minval=5)
i_lowVolThresh   = input.float(0.85,"Low Vol Threshold",  group="Vol Regime", step=0.05)
i_highVolThresh  = input.float(1.20,"High Vol Threshold", group="Vol Regime", step=0.05)
i_lowVolSL       = input.float(0.90,"Low Vol SL Mult",    group="Vol Regime", step=0.05)
i_lowVolTP       = input.float(0.95,"Low Vol TP Mult",    group="Vol Regime", step=0.05)
i_highVolSL      = input.float(1.25,"High Vol SL Mult",   group="Vol Regime", step=0.05)
i_highVolTP      = input.float(1.40,"High Vol TP Mult",   group="Vol Regime", step=0.05)

// Session
i_useSession     = input.bool(true, "Session Filter",     group="Session")

// ── Webhook / MT5 ────────────────────────────────────────────
wh_enable     = input.bool(true,   "Enable Webhook Alerts", group="Webhook / MT5")
wh_atrLen     = input.int(14,      "Webhook ATR Length",    group="Webhook / MT5", minval=1)
wh_tpMult     = input.float(2.0,   "Webhook TP Mult",      group="Webhook / MT5", step=0.1)
wh_slMult     = input.float(1.5,   "Webhook SL Mult",      group="Webhook / MT5", step=0.1)
wh_showLines  = input.bool(true,   "Show Webhook TP/SL",   group="Webhook / MT5")

// ── CALCULATIONS ─────────────────────────────────────────────
emaFast  = ta.ema(close, i_emaFast)
emaSlow  = ta.ema(close, i_emaSlow)
atr14    = ta.atr(14)
volATR   = ta.atr(i_volATR)
volMA    = ta.sma(volATR, i_volMA)

// Trend detection
slopeNorm = atr14 > 0 ? (emaFast - emaFast[i_slopeLookback]) / i_slopeLookback / atr14 : 0
bullTrend = emaFast > emaSlow and slopeNorm >= i_minSlopePips
bearTrend = emaFast < emaSlow and slopeNorm <= -i_minSlopePips

// Volatility regime
volRatio = volMA > 0 ? volATR / volMA : 1.0
slVolMult = volRatio < i_lowVolThresh ? i_lowVolSL : volRatio > i_highVolThresh ? i_highVolSL : 1.0
tpVolMult = volRatio < i_lowVolThresh ? i_lowVolTP : volRatio > i_highVolThresh ? i_highVolTP : 1.0

// Pivot detection
pivotHigh = ta.pivothigh(high, i_swingLeft, i_swingRight)
pivotLow  = ta.pivotlow(low, i_swingLeft, i_swingRight)
entryPivotHigh = ta.pivothigh(high, i_entryLeft, i_entryRight)
entryPivotLow  = ta.pivotlow(low, i_entryLeft, i_entryRight)

// Session filter
inSession = i_useSession ? (hour(time, "UTC") >= 7 and hour(time, "UTC") <= 21) : true

// ── STATE MACHINE ────────────────────────────────────────────
// States: 0=Idle, 1=ImpulseFound, 2=Retracing, 3=Armed
var int   state           = 0
var int   impulseStartBar = 0
var int   impulseEndBar   = 0
var float swingStartPrice = 0.0
var float swingEndPrice   = 0.0
var int   setupDir        = 0   // 1=bull, -1=bear
var int   retraceTouchBar = 0
var float entryBreakLevel = 0.0
var int   cooldownUntil   = 0

// Track recent pivots
var float lastPivotHighPrice = na
var int   lastPivotHighBar   = 0
var float lastPivotLowPrice  = na
var int   lastPivotLowBar    = 0

if not na(pivotHigh)
    lastPivotHighPrice := high[i_swingRight]
    lastPivotHighBar   := bar_index - i_swingRight

if not na(pivotLow)
    lastPivotLowPrice := low[i_swingRight]
    lastPivotLowBar   := bar_index - i_swingRight

// Fib helpers
f_fibRetrace(level, startP, endP, dir) =>
    range_ = math.abs(endP - startP)
    dir == 1 ? endP - range_ * level : endP + range_ * level

f_fibExtension(ext, startP, endP, dir) =>
    range_ = math.abs(endP - startP)
    dir == 1 ? startP + range_ * ext : startP - range_ * ext

// Signal outputs
var bool buySignal  = false
var bool sellSignal = false
var float buySL_price  = na
var float buyTP_price  = na
var float sellSL_price = na
var float sellTP_price = na

buySignal  := false
sellSignal := false

// ── STATE TRANSITIONS ────────────────────────────────────────

// IDLE → IMPULSE FOUND
if state == 0 and bar_index > cooldownUntil
    // Bull impulse: pivot low followed by pivot high
    if bullTrend and not na(lastPivotLowPrice) and not na(lastPivotHighPrice) and lastPivotHighBar > lastPivotLowBar
        impulsePips = lastPivotHighPrice - lastPivotLowPrice
        barsUsed = lastPivotHighBar - lastPivotLowBar
        if impulsePips >= atr14 * i_minImpulseATR and barsUsed <= i_maxImpulseBars and barsUsed > 0
            // Count counter closes
            counterCloses = 0
            for k = lastPivotLowBar to lastPivotHighBar
                idx = bar_index - k
                if idx >= 0 and idx < 500 and close[idx] < open[idx]
                    counterCloses += 1
            if counterCloses <= i_maxCounterBars
                swingStartPrice := lastPivotLowPrice
                swingEndPrice   := lastPivotHighPrice
                impulseStartBar := lastPivotLowBar
                impulseEndBar   := lastPivotHighBar
                setupDir        := 1
                state           := 1

    // Bear impulse: pivot high followed by pivot low
    if state == 0 and bearTrend and not na(lastPivotHighPrice) and not na(lastPivotLowPrice) and lastPivotLowBar > lastPivotHighBar
        impulsePips = lastPivotHighPrice - lastPivotLowPrice
        barsUsed = lastPivotLowBar - lastPivotHighBar
        if impulsePips >= atr14 * i_minImpulseATR and barsUsed <= i_maxImpulseBars and barsUsed > 0
            counterCloses = 0
            for k = lastPivotHighBar to lastPivotLowBar
                idx = bar_index - k
                if idx >= 0 and idx < 500 and close[idx] > open[idx]
                    counterCloses += 1
            if counterCloses <= i_maxCounterBars
                swingStartPrice := lastPivotHighPrice
                swingEndPrice   := lastPivotLowPrice
                impulseStartBar := lastPivotHighBar
                impulseEndBar   := lastPivotLowBar
                setupDir        := -1
                state           := 1

// IMPULSE FOUND / RETRACING → Check invalidation, fib touch, entry pivot
if state == 1 or state == 2
    invPrice = f_fibRetrace(i_invalidation, swingStartPrice, swingEndPrice, setupDir)
    // Invalidation
    invalidated = false
    if setupDir == 1 and close < invPrice - atr14 * i_slBufferATR
        invalidated := true
    if setupDir == -1 and close > invPrice + atr14 * i_slBufferATR
        invalidated := true
    // Timeout
    if bar_index - impulseEndBar > i_maxRetraceBars
        invalidated := true
    // Messy retrace filter
    beyondCount = 0
    lookLen = math.min(bar_index - impulseEndBar, 200)
    if lookLen > 0
        for k = 0 to lookLen - 1
            if setupDir == 1 and close[k] < emaFast[k]
                beyondCount += 1
            if setupDir == -1 and close[k] > emaFast[k]
                beyondCount += 1
    if beyondCount > i_maxBeyondEMA
        invalidated := true

    if invalidated
        state := 0
    else
        // Check fib zone touch
        fibZoneA = f_fibRetrace(i_fibMin, swingStartPrice, swingEndPrice, setupDir)
        fibZoneB = f_fibRetrace(i_fibMax, swingStartPrice, swingEndPrice, setupDir)
        zLow = math.min(fibZoneA, fibZoneB)
        zHigh = math.max(fibZoneA, fibZoneB)

        if state == 1
            touchPrice = setupDir == 1 ? low : high
            if touchPrice >= zLow and touchPrice <= zHigh
                retraceTouchBar := bar_index
                state := 2

        // Check entry pivot formation (after zone touch)
        if state == 2
            if setupDir == 1 and not na(entryPivotHigh)
                pivotBar = bar_index - i_entryRight
                if pivotBar > retraceTouchBar
                    entryBreakLevel := high[i_entryRight] + atr14 * 0.05
                    state := 3
            if setupDir == -1 and not na(entryPivotLow)
                pivotBar = bar_index - i_entryRight
                if pivotBar > retraceTouchBar
                    entryBreakLevel := low[i_entryRight] - atr14 * 0.05
                    state := 3

// ARMED → ENTRY
if state == 3
    // Check invalidation still
    invPrice = f_fibRetrace(i_invalidation, swingStartPrice, swingEndPrice, setupDir)
    if (setupDir == 1 and close < invPrice) or (setupDir == -1 and close > invPrice)
        state := 0
    else if bar_index - impulseEndBar > i_maxRetraceBars + 20
        state := 0
    else
        triggered = false
        if setupDir == 1 and close > entryBreakLevel and inSession
            triggered := true
        if setupDir == -1 and close < entryBreakLevel and inSession
            triggered := true

        if triggered
            // Distance check
            fibZoneA = f_fibRetrace(i_fibMin, swingStartPrice, swingEndPrice, setupDir)
            fibZoneB = f_fibRetrace(i_fibMax, swingStartPrice, swingEndPrice, setupDir)
            zoneMid = (fibZoneA + fibZoneB) / 2
            dist = math.abs(close - zoneMid)
            if dist <= atr14 * i_maxEntryDist
                // Compute SL/TP
                fibTarget = f_fibExtension(i_fibTarget, swingStartPrice, swingEndPrice, setupDir)

                if setupDir == 1
                    anchor = math.min(swingStartPrice, f_fibRetrace(i_invalidation, swingStartPrice, swingEndPrice, 1)) - atr14 * i_slBufferATR
                    baseSL = close - anchor
                    atrSL  = atr14 * i_slATRMult * slVolMult
                    slDist = math.max(baseSL, atrSL)
                    baseTP = fibTarget - close
                    atrTP  = atr14 * i_tpATRMult * tpVolMult
                    tpDist = math.max(baseTP, atrTP)

                    buySL_price  := close - slDist
                    buyTP_price  := close + tpDist
                    buySignal    := true

                if setupDir == -1
                    anchor = math.max(swingStartPrice, f_fibRetrace(i_invalidation, swingStartPrice, swingEndPrice, -1)) + atr14 * i_slBufferATR
                    baseSL = anchor - close
                    atrSL  = atr14 * i_slATRMult * slVolMult
                    slDist = math.max(baseSL, atrSL)
                    baseTP = close - fibTarget
                    atrTP  = atr14 * i_tpATRMult * tpVolMult
                    tpDist = math.max(baseTP, atrTP)

                    sellSL_price := close + slDist
                    sellTP_price := close - tpDist
                    sellSignal   := true

                state := 0
                cooldownUntil := bar_index + 10
            else
                state := 0

// ── VISUALS ──────────────────────────────────────────────────
plot(emaFast, "EMA Fast", color.blue, 1)
plot(emaSlow, "EMA Slow", color.orange, 1)
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// Fib zone visualization
fibZoneA_plot = state >= 1 ? f_fibRetrace(i_fibMin, swingStartPrice, swingEndPrice, setupDir) : na
fibZoneB_plot = state >= 1 ? f_fibRetrace(i_fibMax, swingStartPrice, swingEndPrice, setupDir) : na
p1 = plot(fibZoneA_plot, "Fib Zone A", color.new(color.purple, 80), display=display.none)
p2 = plot(fibZoneB_plot, "Fib Zone B", color.new(color.purple, 80), display=display.none)
fill(p1, p2, color.new(color.purple, 90), title="Fib Zone")

// TP/SL lines on signal
if buySignal
    line.new(bar_index, buyTP_price, bar_index + 20, buyTP_price, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    line.new(bar_index, buySL_price, bar_index + 20, buySL_price, color=color.new(color.red, 30), width=2, style=line.style_dashed)
    label.new(bar_index, buyTP_price, "TP", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, buySL_price, "SL", color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)

if sellSignal
    line.new(bar_index, sellTP_price, bar_index + 20, sellTP_price, color=color.new(color.red, 30), width=2, style=line.style_dashed)
    line.new(bar_index, sellSL_price, bar_index + 20, sellSL_price, color=color.new(color.lime, 30), width=2, style=line.style_dashed)
    label.new(bar_index, sellTP_price, "TP", color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)
    label.new(bar_index, sellSL_price, "SL", color=color.new(color.lime, 30), textcolor=color.white, size=size.tiny)

// State indicator
stateColor = state == 0 ? color.gray : state == 1 ? color.yellow : state == 2 ? color.orange : color.lime
plotshape(state > 0, "State Active", shape.diamond, location.bottom, stateColor, size=size.tiny)

// Info table
var table tbl = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "FB Razor", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "Swing", text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "State", text_color=color.gray, text_size=size.tiny)
    stateStr = state == 0 ? "Idle" : state == 1 ? "Impulse" : state == 2 ? "Retracing" : "Armed"
    table.cell(tbl, 1, 1, stateStr, text_color=stateColor, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, bullTrend ? "BULL" : bearTrend ? "BEAR" : "FLAT", text_color=bullTrend ? color.lime : bearTrend ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Vol Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(volRatio, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "Direction", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, setupDir == 1 ? "LONG" : setupDir == -1 ? "SHORT" : "NONE", text_color=setupDir == 1 ? color.lime : setupDir == -1 ? color.red : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 5, "EQH/EQL", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 5, i_enableEQHL ? "ON" : "OFF", text_color=i_enableEQHL ? color.lime : color.gray, text_size=size.tiny)

// ── WEBHOOK ENHANCEMENT ──────────────────────────────────────
wh_atr = ta.atr(wh_atrLen)

// Use existing indicator TP/SL prices
wh_buyTP  = buySignal  ? buyTP_price  : na
wh_buySL  = buySignal  ? buySL_price  : na
wh_sellTP = sellSignal ? sellTP_price : na
wh_sellSL = sellSignal ? sellSL_price : na

wh_buyRR  = buySignal  and buySL_price < close ? str.tostring(math.round((buyTP_price - close) / (close - buySL_price), 2)) : "0"
wh_sellRR = sellSignal and sellSL_price > close ? str.tostring(math.round((close - sellTP_price) / (sellSL_price - close), 2)) : "0"

// Alert conditions
alertcondition(buySignal,  title="FBRazor BUY",  message="FBRazor BUY signal")
alertcondition(sellSignal, title="FBRazor SELL", message="FBRazor SELL signal")

// Webhook JSON alerts
if wh_enable and buySignal
    wh_msg = '{"indicator_id":"FBRazor","strategy_id":"fb_razor_swing","symbol":"' + syminfo.ticker + '","action":"BUY","risk":1.0,"meta":{"tp":' + str.tostring(wh_buyTP, "#.#####") + ',"sl":' + str.tostring(wh_buySL, "#.#####") + ',"rr":"' + wh_buyRR + ':1"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

if wh_enable and sellSignal
    wh_msg = '{"indicator_id":"FBRazor","strategy_id":"fb_razor_swing","symbol":"' + syminfo.ticker + '","action":"SELL","risk":1.0,"meta":{"tp":' + str.tostring(wh_sellTP, "#.#####") + ',"sl":' + str.tostring(wh_sellSL, "#.#####") + ',"rr":"' + wh_sellRR + ':1"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

// Webhook TP/SL chart lines
if wh_showLines and wh_enable and buySignal
    line.new(bar_index, wh_buyTP, bar_index + 25, wh_buyTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, wh_buySL, bar_index + 25, wh_buySL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, wh_buyTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, wh_buySL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)

if wh_showLines and wh_enable and sellSignal
    line.new(bar_index, wh_sellTP, bar_index + 25, wh_sellTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, wh_sellSL, bar_index + 25, wh_sellSL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, wh_sellTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, wh_sellSL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)
