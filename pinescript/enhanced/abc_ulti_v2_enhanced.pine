//@version=5
indicator("ABC Ulti V2", shorttitle="ABCUltiV2", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ── INPUTS ───────────────────────────────────────────────────
i_zigzagLen    = input.int(10,    "Zigzag Sensitivity",  group="Pattern", minval=2)
i_minRet       = input.float(0.236,"Min BC Retrace",     group="Pattern", step=0.01)
i_maxRet       = input.float(0.886,"Max BC Retrace",     group="Pattern", step=0.01)
i_maxPatterns  = input.int(3,      "Max Patterns",       group="Pattern", minval=1, maxval=5)
i_fibExt1      = input.float(1.618,"Fib Extension T1",   group="Targets", step=0.01)
i_fibExt2      = input.float(1.809,"Fib Extension T2",   group="Targets", step=0.01)
i_fibExt3      = input.float(2.0,  "Fib Extension T3",   group="Targets", step=0.01)
i_invLevel     = input.float(0.886,"Invalidation Level",  group="Targets", step=0.01)
i_lineColor    = input.color(color.gray, "ABC Line Color", group="Visual")
i_lineWidth    = input.int(2,      "Line Width",          group="Visual", minval=1, maxval=4)
i_showSR       = input.bool(true,  "Show S/R Lines",      group="S/R")
i_srBasis      = input.string("Wicks", "S/R Basis",       group="S/R", options=["Wicks", "Body"])
i_srStrength   = input.int(10,     "S/R Strength",        group="S/R", minval=3)
i_supLines     = input.int(3,      "Support Lines",       group="S/R", minval=0, maxval=5)
i_resLines     = input.int(3,      "Resistance Lines",    group="S/R", minval=0, maxval=5)

// ── Webhook / MT5 ────────────────────────────────────────────
wh_enable     = input.bool(true,   "Enable Webhook Alerts", group="Webhook / MT5")
wh_atrLen     = input.int(14,      "Webhook ATR Length",    group="Webhook / MT5", minval=1)
wh_tpMult     = input.float(2.0,   "Webhook TP Mult",      group="Webhook / MT5", step=0.1)
wh_slMult     = input.float(1.5,   "Webhook SL Mult",      group="Webhook / MT5", step=0.1)
wh_showLines  = input.bool(true,   "Show Webhook TP/SL",   group="Webhook / MT5")

// ── ZIGZAG (inline replacement for Trendoscope library) ──────
var float[] zigPrices  = array.new_float(0)
var int[]   zigBars    = array.new_int(0)
var int[]   zigDirs    = array.new_int(0)  // 1=high, -1=low
var int     zigDir     = 0

// Track current swing
var float curHigh  = high
var float curLow   = low
var int   curHighB = bar_index
var int   curLowB  = bar_index

isHighest = high == ta.highest(high, i_zigzagLen)
isLowest  = low == ta.lowest(low, i_zigzagLen)

// Zigzag detection
newPivot = false
pivotPrice = 0.0
pivotBar   = 0
pivotDir   = 0

if isHighest and not isLowest
    if zigDir != 1
        if zigDir == 0 or (zigDir == -1 and array.size(zigPrices) > 0)
            pivotPrice := high
            pivotBar   := bar_index
            pivotDir   := 1
            newPivot   := true
        zigDir := 1
    else if high > curHigh
        curHigh  := high
        curHighB := bar_index
        if array.size(zigPrices) > 0
            array.set(zigPrices, 0, high)
            array.set(zigBars, 0, bar_index)

if isLowest and not isHighest
    if zigDir != -1
        if zigDir == 0 or (zigDir == 1 and array.size(zigPrices) > 0)
            pivotPrice := low
            pivotBar   := bar_index
            pivotDir   := -1
            newPivot   := true
        zigDir := -1
    else if low < curLow
        curLow  := low
        curLowB := bar_index
        if array.size(zigPrices) > 0
            array.set(zigPrices, 0, low)
            array.set(zigBars, 0, bar_index)

if newPivot
    array.unshift(zigPrices, pivotPrice)
    array.unshift(zigBars, pivotBar)
    array.unshift(zigDirs, pivotDir)
    if pivotDir == 1
        curHigh  := high
        curHighB := bar_index
    else
        curLow  := low
        curLowB := bar_index
    // Trim
    while array.size(zigPrices) > 50
        array.pop(zigPrices)
        array.pop(zigBars)
        array.pop(zigDirs)

// ── ABC PATTERN DETECTION ────────────────────────────────────
var bool buySignal  = false
var bool sellSignal = false
var float buyTP     = na
var float buySL     = na
var float sellTP    = na
var float sellSL    = na

buySignal  := false
sellSignal := false

if newPivot and array.size(zigPrices) >= 4
    // Most recent 3 pivots form potential ABC
    cPrice = array.get(zigPrices, 0)
    bPrice = array.get(zigPrices, 1)
    aPrice = array.get(zigPrices, 2)
    cBar   = array.get(zigBars, 0)
    bBar   = array.get(zigBars, 1)
    aBar   = array.get(zigBars, 2)
    cDir   = array.get(zigDirs, 0)

    abRange = math.abs(bPrice - aPrice)

    if abRange > 0
        bcRetrace = math.abs(cPrice - bPrice) / abRange

        if bcRetrace >= i_minRet and bcRetrace <= i_maxRet
            // Bullish ABC: A=low, B=high, C=low (higher low)
            if cDir == -1 and bPrice > aPrice and cPrice > aPrice and cPrice < bPrice
                // Targets via Fib extension
                t1 = cPrice + abRange * i_fibExt1
                t2 = cPrice + abRange * i_fibExt2
                t3 = cPrice + abRange * i_fibExt3
                inv = cPrice - abRange * (i_invLevel - 0.5)

                buyTP      := t1
                buySL      := math.min(aPrice, inv)
                buySignal  := true

                // Draw pattern
                line.new(aBar, aPrice, bBar, bPrice, color=i_lineColor, width=i_lineWidth)
                line.new(bBar, bPrice, cBar, cPrice, color=i_lineColor, width=i_lineWidth)
                label.new(aBar, aPrice, "A", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_up, size=size.tiny)
                label.new(bBar, bPrice, "B", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_down, size=size.tiny)
                label.new(cBar, cPrice, "C", color=color.new(color.lime, 80), textcolor=color.white, style=label.style_label_up, size=size.tiny)

                // Target zone
                line.new(cBar, t1, cBar + 30, t1, color=color.new(color.lime, 50), width=1, style=line.style_dashed)
                label.new(cBar + 15, t1, "T1", color=color.new(color.lime, 80), textcolor=color.white, size=size.tiny)

            // Bearish ABC: A=high, B=low, C=high (lower high)
            if cDir == 1 and bPrice < aPrice and cPrice < aPrice and cPrice > bPrice
                t1 = cPrice - abRange * i_fibExt1
                t2 = cPrice - abRange * i_fibExt2
                t3 = cPrice - abRange * i_fibExt3
                inv = cPrice + abRange * (i_invLevel - 0.5)

                sellTP     := t1
                sellSL     := math.max(aPrice, inv)
                sellSignal := true

                line.new(aBar, aPrice, bBar, bPrice, color=i_lineColor, width=i_lineWidth)
                line.new(bBar, bPrice, cBar, cPrice, color=i_lineColor, width=i_lineWidth)
                label.new(aBar, aPrice, "A", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_down, size=size.tiny)
                label.new(bBar, bPrice, "B", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_up, size=size.tiny)
                label.new(cBar, cPrice, "C", color=color.new(color.red, 80), textcolor=color.white, style=label.style_label_down, size=size.tiny)

                line.new(cBar, t1, cBar + 30, t1, color=color.new(color.red, 50), width=1, style=line.style_dashed)
                label.new(cBar + 15, t1, "T1", color=color.new(color.red, 80), textcolor=color.white, size=size.tiny)

// ── S/R LEVELS ───────────────────────────────────────────────
pivHigh = ta.pivothigh(i_srBasis == "Wicks" ? high : math.max(open, close), i_srStrength, i_srStrength)
pivLow  = ta.pivotlow(i_srBasis == "Wicks" ? low : math.min(open, close), i_srStrength, i_srStrength)

var float[] resLevels = array.new_float(0)
var float[] supLevels = array.new_float(0)

if not na(pivHigh) and i_showSR
    array.unshift(resLevels, pivHigh)
    while array.size(resLevels) > i_resLines
        array.pop(resLevels)

if not na(pivLow) and i_showSR
    array.unshift(supLevels, pivLow)
    while array.size(supLevels) > i_supLines
        array.pop(supLevels)

// ── VISUALS ──────────────────────────────────────────────────
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// Info table
var table tbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "ABC Ulti V2", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "Zigzag: " + str.tostring(i_zigzagLen), text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "Pivots", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(array.size(zigPrices)), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 2, "BC Range", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(i_minRet, "#.###") + " - " + str.tostring(i_maxRet, "#.###"), text_color=color.white, text_size=size.tiny)

// ── WEBHOOK ENHANCEMENT ──────────────────────────────────────
wh_atr = ta.atr(wh_atrLen)

// Use existing indicator TP/SL prices
wh_buyTP  = buySignal  ? buyTP  : na
wh_buySL  = buySignal  ? buySL  : na
wh_sellTP = sellSignal ? sellTP : na
wh_sellSL = sellSignal ? sellSL : na

wh_buyRR  = buySignal  and buySL < close ? str.tostring(math.round((buyTP - close) / (close - buySL), 2)) : "0"
wh_sellRR = sellSignal and sellSL > close ? str.tostring(math.round((close - sellTP) / (sellSL - close), 2)) : "0"

// Alert conditions
alertcondition(buySignal,  title="ABCUltiV2 BUY",  message="ABCUltiV2 BUY signal")
alertcondition(sellSignal, title="ABCUltiV2 SELL", message="ABCUltiV2 SELL signal")

// Webhook JSON alerts
if wh_enable and buySignal
    wh_msg = '{"indicator_id":"ABCUltiV2","strategy_id":"abc_ulti_v2","symbol":"' + syminfo.ticker + '","action":"BUY","risk":1.0,"meta":{"tp":' + str.tostring(wh_buyTP, "#.#####") + ',"sl":' + str.tostring(wh_buySL, "#.#####") + ',"rr":"' + wh_buyRR + ':1"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

if wh_enable and sellSignal
    wh_msg = '{"indicator_id":"ABCUltiV2","strategy_id":"abc_ulti_v2","symbol":"' + syminfo.ticker + '","action":"SELL","risk":1.0,"meta":{"tp":' + str.tostring(wh_sellTP, "#.#####") + ',"sl":' + str.tostring(wh_sellSL, "#.#####") + ',"rr":"' + wh_sellRR + ':1"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

// Webhook TP/SL chart lines
if wh_showLines and wh_enable and buySignal
    line.new(bar_index, wh_buyTP, bar_index + 25, wh_buyTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, wh_buySL, bar_index + 25, wh_buySL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, wh_buyTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, wh_buySL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)

if wh_showLines and wh_enable and sellSignal
    line.new(bar_index, wh_sellTP, bar_index + 25, wh_sellTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, wh_sellSL, bar_index + 25, wh_sellSL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, wh_sellTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, wh_sellSL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)
