//@version=5
indicator("ABC Ulti V2 [BOS+Fib Enhanced]", shorttitle="ABCUltiV2", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ── INPUTS ───────────────────────────────────────────────────
i_zigzagLen    = input.int(10,    "Zigzag Sensitivity",  group="Pattern", minval=2)
i_minRet       = input.float(0.382,"Min B Retrace",      group="Pattern", step=0.01)
i_maxRet       = input.float(0.786,"Max B Retrace",      group="Pattern", step=0.01)
i_maxPatterns  = input.int(3,      "Max Patterns",       group="Pattern", minval=1, maxval=5)
i_showFibs     = input.bool(true,  "Show Fib Levels",    group="Visual")
i_lineColor    = input.color(color.gray, "ABC Line Color", group="Visual")
i_lineWidth    = input.int(2,      "Line Width",          group="Visual", minval=1, maxval=4)
i_showSR       = input.bool(true,  "Show S/R Lines",      group="S/R")
i_srBasis      = input.string("Wicks", "S/R Basis",       group="S/R", options=["Wicks", "Body"])
i_srStrength   = input.int(10,     "S/R Strength",        group="S/R", minval=3)
i_supLines     = input.int(3,      "Support Lines",       group="S/R", minval=0, maxval=5)
i_resLines     = input.int(3,      "Resistance Lines",    group="S/R", minval=0, maxval=5)

// ── Webhook / MT5 ────────────────────────────────────────────
wh_enable     = input.bool(true,   "Enable Webhook Alerts", group="Webhook / MT5")
wh_showLines  = input.bool(true,   "Show Webhook TP/SL",   group="Webhook / MT5")

// ── ZIGZAG ENGINE (inline) ───────────────────────────────────
var float[] zigPrices  = array.new_float(0)
var int[]   zigBars    = array.new_int(0)
var int[]   zigDirs    = array.new_int(0)
var int     zigDir     = 0
var float   curHigh    = high
var float   curLow     = low
var int     curHighB   = bar_index
var int     curLowB    = bar_index

isHighest = high == ta.highest(high, i_zigzagLen)
isLowest  = low  == ta.lowest(low, i_zigzagLen)

newPivot   = false
pivotPrice = 0.0
pivotBar   = 0
pivotDir   = 0

if isHighest and not isLowest
    if zigDir != 1
        if zigDir == 0 or (zigDir == -1 and array.size(zigPrices) > 0)
            pivotPrice := high
            pivotBar   := bar_index
            pivotDir   := 1
            newPivot   := true
        zigDir := 1
    else if high > curHigh
        curHigh  := high
        curHighB := bar_index
        if array.size(zigPrices) > 0
            array.set(zigPrices, 0, high)
            array.set(zigBars, 0, bar_index)

if isLowest and not isHighest
    if zigDir != -1
        if zigDir == 0 or (zigDir == 1 and array.size(zigPrices) > 0)
            pivotPrice := low
            pivotBar   := bar_index
            pivotDir   := -1
            newPivot   := true
        zigDir := -1
    else if low < curLow
        curLow  := low
        curLowB := bar_index
        if array.size(zigPrices) > 0
            array.set(zigPrices, 0, low)
            array.set(zigBars, 0, bar_index)

if newPivot
    array.unshift(zigPrices, pivotPrice)
    array.unshift(zigBars, pivotBar)
    array.unshift(zigDirs, pivotDir)
    if pivotDir == 1
        curHigh  := high
        curHighB := bar_index
    else
        curLow  := low
        curLowB := bar_index
    while array.size(zigPrices) > 50
        array.pop(zigPrices)
        array.pop(zigBars)
        array.pop(zigDirs)

// ── ABC + BOS PATTERN DETECTION ──────────────────────────────
var bool  buySignal  = false
var bool  sellSignal = false
var float buyTP      = na
var float buySL      = na
var float sellTP     = na
var float sellSL     = na
var float gpTop      = na
var float gpBot      = na
var int   gpDir      = 0
var string lastABCPoint = ""

buySignal  := false
sellSignal := false

if newPivot and array.size(zigPrices) >= 4
    cPrice = array.get(zigPrices, 0)
    bPrice = array.get(zigPrices, 1)
    aPrice = array.get(zigPrices, 2)
    cBar   = array.get(zigBars, 0)
    bBar   = array.get(zigBars, 1)
    aBar   = array.get(zigBars, 2)
    cDir   = array.get(zigDirs, 0)
    abRange = math.abs(bPrice - aPrice)

    if abRange > 0
        // --- BULLISH ABC + BOS ---
        if cDir == -1 and bPrice > aPrice and cPrice < aPrice
            acRange = math.abs(aPrice - cPrice)
            fib50   = cPrice + acRange * 0.5
            fib618  = cPrice + acRange * 0.618
            fib786  = cPrice + acRange * 0.786
            ext1272 = cPrice + acRange * 1.272
            ext1618 = cPrice + acRange * 1.618
            ext200  = cPrice + acRange * 2.0

            buyTP      := ext1618
            buySL      := cPrice - acRange * 0.786
            buySignal  := true
            lastABCPoint := "C_BOS_BULL"
            gpTop := fib618
            gpBot := fib50
            gpDir := 1

            line.new(aBar, aPrice, bBar, bPrice, color=i_lineColor, width=i_lineWidth)
            line.new(bBar, bPrice, cBar, cPrice, color=i_lineColor, width=i_lineWidth)
            label.new(aBar, aPrice, "A", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_up, size=size.tiny)
            label.new(bBar, bPrice, "B", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_down, size=size.tiny)
            label.new(cBar, cPrice, "C\nBOS", color=color.new(color.lime, 60), textcolor=color.white, style=label.style_label_up, size=size.tiny)
            label.new(cBar + 5, fib618, "D Zone", color=color.new(color.orange, 60), textcolor=color.white, style=label.style_label_left, size=size.tiny)

            if i_showFibs
                int fibLen = 40
                line.new(cBar, fib50,  cBar + fibLen, fib50,  color=color.new(#FFD700, 30), width=1, style=line.style_dashed)
                line.new(cBar, fib618, cBar + fibLen, fib618, color=color.new(color.green, 30), width=1, style=line.style_dashed)
                line.new(cBar, fib786, cBar + fibLen, fib786, color=color.new(color.red, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext1272, cBar + fibLen, ext1272, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext1618, cBar + fibLen, ext1618, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext200,  cBar + fibLen, ext200,  color=color.new(color.blue, 30), width=1, style=line.style_dashed)

        // --- BEARISH ABC + BOS ---
        if cDir == 1 and bPrice < aPrice and cPrice > aPrice
            acRange = math.abs(cPrice - aPrice)
            fib50   = cPrice - acRange * 0.5
            fib618  = cPrice - acRange * 0.618
            fib786  = cPrice - acRange * 0.786
            ext1272 = cPrice - acRange * 1.272
            ext1618 = cPrice - acRange * 1.618
            ext200  = cPrice - acRange * 2.0

            sellTP     := ext1618
            sellSL     := cPrice + acRange * 0.786
            sellSignal := true
            lastABCPoint := "C_BOS_BEAR"
            gpTop := fib50
            gpBot := fib618
            gpDir := -1

            line.new(aBar, aPrice, bBar, bPrice, color=i_lineColor, width=i_lineWidth)
            line.new(bBar, bPrice, cBar, cPrice, color=i_lineColor, width=i_lineWidth)
            label.new(aBar, aPrice, "A", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_down, size=size.tiny)
            label.new(bBar, bPrice, "B", color=color.new(color.blue, 80), textcolor=color.white, style=label.style_label_up, size=size.tiny)
            label.new(cBar, cPrice, "C\nBOS", color=color.new(color.red, 60), textcolor=color.white, style=label.style_label_down, size=size.tiny)
            label.new(cBar + 5, fib618, "D Zone", color=color.new(color.orange, 60), textcolor=color.white, style=label.style_label_left, size=size.tiny)

            if i_showFibs
                int fibLen = 40
                line.new(cBar, fib50,  cBar + fibLen, fib50,  color=color.new(#FFD700, 30), width=1, style=line.style_dashed)
                line.new(cBar, fib618, cBar + fibLen, fib618, color=color.new(color.green, 30), width=1, style=line.style_dashed)
                line.new(cBar, fib786, cBar + fibLen, fib786, color=color.new(color.red, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext1272, cBar + fibLen, ext1272, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext1618, cBar + fibLen, ext1618, color=color.new(color.blue, 30), width=1, style=line.style_dashed)
                line.new(cBar, ext200,  cBar + fibLen, ext200,  color=color.new(color.blue, 30), width=1, style=line.style_dashed)

// ── S/R LEVELS ───────────────────────────────────────────────
pivHigh = ta.pivothigh(i_srBasis == "Wicks" ? high : math.max(open, close), i_srStrength, i_srStrength)
pivLow  = ta.pivotlow(i_srBasis == "Wicks" ? low : math.min(open, close), i_srStrength, i_srStrength)

var float[] resLevels = array.new_float(0)
var float[] supLevels = array.new_float(0)

if not na(pivHigh) and i_showSR
    array.unshift(resLevels, pivHigh)
    while array.size(resLevels) > i_resLines
        array.pop(resLevels)

if not na(pivLow) and i_showSR
    array.unshift(supLevels, pivLow)
    while array.size(supLevels) > i_supLines
        array.pop(supLevels)

// ── VISUALS ──────────────────────────────────────────────────
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

inGoldenPocket = (gpDir == 1 and close >= gpBot and close <= gpTop) or (gpDir == -1 and close <= gpTop and close >= gpBot)
bgcolor(inGoldenPocket ? color.new(color.orange, 90) : na, title="Golden Pocket Zone")

// Info table
var table tbl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "ABC Ulti V2", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "BOS+Fib Enhanced", text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 1, "Zigzag", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(i_zigzagLen), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Pivots", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(array.size(zigPrices)), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 3, "Mode", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, "BOS Confirm", text_color=color.orange, text_size=size.tiny)

// ── WEBHOOK / ALERT ENHANCEMENT ──────────────────────────────
wh_buyRR  = buySignal  and buySL < close ? str.tostring(math.round((buyTP - close) / (close - buySL), 2)) : "0"
wh_sellRR = sellSignal and sellSL > close ? str.tostring(math.round((close - sellTP) / (sellSL - close), 2)) : "0"

// Alert conditions
alertcondition(buySignal,  title="ABCUltiV2 BUY",  message="ABCUltiV2 BOS BUY signal")
alertcondition(sellSignal, title="ABCUltiV2 SELL", message="ABCUltiV2 BOS SELL signal")

// Webhook JSON alerts with abc_point info
if wh_enable and buySignal
    wh_msg = '{"indicator_id":"ABCUltiV2","strategy_id":"abc_ulti_v2","symbol":"' + syminfo.ticker + '","action":"BUY","abc_point":"' + lastABCPoint + '","bos":true,"risk":1.0,"meta":{"tp":' + str.tostring(buyTP, "#.#####") + ',"sl":' + str.tostring(buySL, "#.#####") + ',"rr":"' + wh_buyRR + ':1","fib_entry":"golden_pocket_0.5_0.618"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

if wh_enable and sellSignal
    wh_msg = '{"indicator_id":"ABCUltiV2","strategy_id":"abc_ulti_v2","symbol":"' + syminfo.ticker + '","action":"SELL","abc_point":"' + lastABCPoint + '","bos":true,"risk":1.0,"meta":{"tp":' + str.tostring(sellTP, "#.#####") + ',"sl":' + str.tostring(sellSL, "#.#####") + ',"rr":"' + wh_sellRR + ':1","fib_entry":"golden_pocket_0.5_0.618"}}'
    alert(wh_msg, alert.freq_once_per_bar_close)

// Webhook TP/SL chart lines
if wh_showLines and wh_enable and buySignal
    line.new(bar_index, buyTP, bar_index + 25, buyTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, buySL, bar_index + 25, buySL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, buyTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, buySL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)

if wh_showLines and wh_enable and sellSignal
    line.new(bar_index, sellTP, bar_index + 25, sellTP, color=color.new(color.teal, 20), width=1, style=line.style_dotted)
    line.new(bar_index, sellSL, bar_index + 25, sellSL, color=color.new(color.maroon, 20), width=1, style=line.style_dotted)
    label.new(bar_index + 25, sellTP, "WH-TP", color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, sellSL, "WH-SL", color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)
