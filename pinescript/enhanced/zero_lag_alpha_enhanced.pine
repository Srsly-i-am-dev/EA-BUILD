//@version=5
indicator("Zero Lag Trend Signals MTF", shorttitle="ZLAlpha", overlay=true)

// ── INPUTS ───────────────────────────────────────────────────
length = input.int(70, "Length", group="Main Calculations")
mult   = input.float(1.2, "Band Multiplier", group="Main Calculations")
t1 = input.timeframe("5",   "Time frame 1", group="Extra Timeframes")
t2 = input.timeframe("15",  "Time frame 2", group="Extra Timeframes")
t3 = input.timeframe("60",  "Time frame 3", group="Extra Timeframes")
t4 = input.timeframe("240", "Time frame 4", group="Extra Timeframes")
t5 = input.timeframe("1D",  "Time frame 5", group="Extra Timeframes")
green_c = input.color(#00ffbb, "Bullish Color", group="Appearance")
red_c   = input.color(#ff1100, "Bearish Color", group="Appearance")

// ── WEBHOOK TP/SL INPUTS ─────────────────────────────────────
wh_enable      = input.bool(true,  "Enable Webhook Alerts",    group="Webhook / MT5")
wh_atrLen      = input.int(14,     "ATR Length",               group="Webhook / MT5", minval=1)
wh_tpMult      = input.float(2.0,  "TP ATR Multiplier",        group="Webhook / MT5", minval=0.1, step=0.1)
wh_slMult      = input.float(1.0,  "SL ATR Multiplier",        group="Webhook / MT5", minval=0.1, step=0.1)
wh_showLines   = input.bool(true,  "Show TP/SL Lines on Chart",group="Webhook / MT5")

src = close

// ── CALCULATIONS ─────────────────────────────────────────────
lag = math.floor((length - 1) / 2)
zlema = ta.ema(src + (src - src[lag]), length)
volatility = ta.highest(ta.atr(length), length * 3) * mult

var trend = 0
if ta.crossover(close, zlema + volatility)
    trend := 1
if ta.crossunder(close, zlema - volatility)
    trend := -1

// ── SIGNALS ──────────────────────────────────────────────────
buySignal  = ta.crossover(close, zlema) and trend == 1 and trend[1] == 1
sellSignal = ta.crossunder(close, zlema) and trend == -1 and trend[1] == -1
trendBullish = ta.crossover(trend, 0)
trendBearish = ta.crossunder(trend, 0)

// ── MTF ──────────────────────────────────────────────────────
s1 = request.security(syminfo.tickerid, t1, trend)
s2 = request.security(syminfo.tickerid, t2, trend)
s3 = request.security(syminfo.tickerid, t3, trend)
s4 = request.security(syminfo.tickerid, t4, trend)
s5 = request.security(syminfo.tickerid, t5, trend)

// ── VISUALS ──────────────────────────────────────────────────
zlemaColor = trend == 1 ? color.new(green_c, 70) : color.new(red_c, 70)
m = plot(zlema, title="Zero Lag Basis", linewidth=2, color=zlemaColor)
upper = plot(trend == -1 ? zlema + volatility : na, style=plot.style_linebr, color=color.new(red_c, 90), title="Upper Band")
lower = plot(trend == 1 ? zlema - volatility : na, style=plot.style_linebr, color=color.new(green_c, 90), title="Lower Band")

fill(m, upper, (open + close) / 2, zlema + volatility, color.new(red_c, 90), color.new(red_c, 70))
fill(m, lower, (open + close) / 2, zlema - volatility, color.new(green_c, 90), color.new(green_c, 70))

plotshape(trendBearish ? zlema + volatility : na, "Bearish Trend", shape.labeldown, location.absolute, red_c, text="v", textcolor=color.white, size=size.small)
plotshape(trendBullish ? zlema - volatility : na, "Bullish Trend", shape.labelup, location.absolute, green_c, text="^", textcolor=color.white, size=size.small)

plotchar(buySignal ? zlema - volatility * 1.5 : na, "Bullish Entry", "^", location.absolute, green_c, size=size.tiny)
plotchar(sellSignal ? zlema + volatility * 1.5 : na, "Bearish Entry", "v", location.absolute, red_c, size=size.tiny)

// ── MTF TABLE ────────────────────────────────────────────────
if barstate.islast
    var data_table = table.new(position=position.top_right, columns=2, rows=6, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(data_table, 0, 0, "TF",     text_color=color.white)
    table.cell(data_table, 1, 0, "Signal", text_color=color.white)
    table.cell(data_table, 0, 1, t1, text_color=color.white)
    table.cell(data_table, 1, 1, s1 == 1 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=s1 == 1 ? color.new(green_c, 70) : color.new(red_c, 70))
    table.cell(data_table, 0, 2, t2, text_color=color.white)
    table.cell(data_table, 1, 2, s2 == 1 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=s2 == 1 ? color.new(green_c, 70) : color.new(red_c, 70))
    table.cell(data_table, 0, 3, t3, text_color=color.white)
    table.cell(data_table, 1, 3, s3 == 1 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=s3 == 1 ? color.new(green_c, 70) : color.new(red_c, 70))
    table.cell(data_table, 0, 4, t4, text_color=color.white)
    table.cell(data_table, 1, 4, s4 == 1 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=s4 == 1 ? color.new(green_c, 70) : color.new(red_c, 70))
    table.cell(data_table, 0, 5, t5, text_color=color.white)
    table.cell(data_table, 1, 5, s5 == 1 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=s5 == 1 ? color.new(green_c, 70) : color.new(red_c, 70))

// ── WEBHOOK ALERTS (ATR-based TP/SL) ─────────────────────────
wh_atr    = ta.atr(wh_atrLen)
wh_buyTP  = close + wh_atr * wh_tpMult
wh_buySL  = close - wh_atr * wh_slMult
wh_sellTP = close - wh_atr * wh_tpMult
wh_sellSL = close + wh_atr * wh_slMult

wh_buyRR  = wh_buySL != close ? math.abs((wh_buyTP - close) / (close - wh_buySL)) : 0.0
wh_sellRR = wh_sellSL != close ? math.abs((close - wh_sellTP) / (wh_sellSL - close)) : 0.0

// alertcondition (keep original ones and add webhook ones)
alertcondition(buySignal,  title="ZLAlpha BUY",  message='{"indicator_id":"ZLAlpha","strategy_id":"zero_lag_alpha","symbol":"{{ticker}}","action":"BUY","risk":1.0,"meta":{"tp":{{close}},"sl":{{close}},"rr":"0:1"}}')
alertcondition(sellSignal, title="ZLAlpha SELL", message='{"indicator_id":"ZLAlpha","strategy_id":"zero_lag_alpha","symbol":"{{ticker}}","action":"SELL","risk":1.0,"meta":{"tp":{{close}},"sl":{{close}},"rr":"0:1"}}')
alertcondition(trendBullish, "Bullish Trend")
alertcondition(trendBearish, "Bearish Trend")

// alert() with full JSON payload
if wh_enable and buySignal
    wh_buyMsg = '{"indicator_id":"ZLAlpha","strategy_id":"zero_lag_alpha","symbol":"' + syminfo.ticker + '","action":"BUY","risk":1.0,"meta":{"tp":' + str.tostring(wh_buyTP, "#.#####") + ',"sl":' + str.tostring(wh_buySL, "#.#####") + ',"rr":"' + str.tostring(wh_buyRR, "#.##") + ':1"}}'
    alert(wh_buyMsg, alert.freq_once_per_bar_close)

if wh_enable and sellSignal
    wh_sellMsg = '{"indicator_id":"ZLAlpha","strategy_id":"zero_lag_alpha","symbol":"' + syminfo.ticker + '","action":"SELL","risk":1.0,"meta":{"tp":' + str.tostring(wh_sellTP, "#.#####") + ',"sl":' + str.tostring(wh_sellSL, "#.#####") + ',"rr":"' + str.tostring(wh_sellRR, "#.##") + ':1"}}'
    alert(wh_sellMsg, alert.freq_once_per_bar_close)

// ── WEBHOOK TP/SL CHART LINES (last bar) ─────────────────────
if wh_showLines and barstate.islast
    if buySignal
        line.new(bar_index - 1, wh_buyTP, bar_index + 5, wh_buyTP, color=color.new(color.aqua, 20), width=2, style=line.style_dotted)
        line.new(bar_index - 1, wh_buySL, bar_index + 5, wh_buySL, color=color.new(color.fuchsia, 20), width=2, style=line.style_dotted)
        label.new(bar_index + 5, wh_buyTP, "WH-TP " + str.tostring(wh_buyTP, "#.##"), color=color.new(color.aqua, 80), textcolor=color.aqua, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 5, wh_buySL, "WH-SL " + str.tostring(wh_buySL, "#.##"), color=color.new(color.fuchsia, 80), textcolor=color.fuchsia, style=label.style_label_left, size=size.tiny)
    if sellSignal
        line.new(bar_index - 1, wh_sellTP, bar_index + 5, wh_sellTP, color=color.new(color.aqua, 20), width=2, style=line.style_dotted)
        line.new(bar_index - 1, wh_sellSL, bar_index + 5, wh_sellSL, color=color.new(color.fuchsia, 20), width=2, style=line.style_dotted)
        label.new(bar_index + 5, wh_sellTP, "WH-TP " + str.tostring(wh_sellTP, "#.##"), color=color.new(color.aqua, 80), textcolor=color.aqua, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 5, wh_sellSL, "WH-SL " + str.tostring(wh_sellSL, "#.##"), color=color.new(color.fuchsia, 80), textcolor=color.fuchsia, style=label.style_label_left, size=size.tiny)
